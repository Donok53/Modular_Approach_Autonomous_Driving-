<launch>
  <arg name="enable" default="true"/>
  <arg name="source_dir" default="$(env HOME)/Downloads/test"/>
  <arg name="destination_dir" default="$(find lio_localizer)/map/test"/>
  <arg name="sync_astar_ref" default="true"/>
  <arg name="source_ref_file" default="map_reference_coordinate.csv"/>
  <arg name="astar_ref_destination_file" default="$(find astar_map)/map/map_reference_coordinate.csv"/>
  <arg name="wait_timeout_s" default="120.0"/>
  <arg name="poll_period_s" default="0.5"/>
  <arg name="stable_checks" default="3"/>
  <arg name="delete_extra" default="true"/>
  <arg name="copy_on_start" default="false"/>
  <arg name="extend_existing_map" default="false"/>
  <arg name="extension_backup_dir" default="$(arg destination_dir)_extension_backups"/>
  <arg name="extension_voxel_leaf_size" default="0.08"/>
  <arg name="extension_keep_existing_ref" default="true"/>
  <arg name="export_global_map_2d_pcd" default="true"/>
  <arg name="global_map_input_file" default="GlobalMap.pcd"/>
  <arg name="global_map_2d_output" default="GlobalMap2D.pcd"/>
  <arg name="global_map_2d_z_value" default="0.0"/>
  <arg name="global_map_2d_binary_output" default="true"/>
  <arg name="global_map_2d_xy_leaf_size" default="0.20"/>
  <arg name="generate_semantic_sidewalk" default="false"/>
  <arg name="semantic_sidewalk_output_dir" default="semantic_sidewalk"/>
  <arg name="semantic_state_output" default="semantic_sidewalk_state.json"/>
  <arg name="semantic_drivable_state_output" default="lio_sam_drivable_area_state.json"/>
  <arg name="semantic_global_drivable_state_file" default="$(env HOME)/.ros/lio_sam_drivable_area_state.json"/>
  <arg name="semantic_source_bag" default=""/>
  <arg name="semantic_auto_detect_source_bag" default="true"/>
  <arg name="semantic_detect_bag_poll_period_s" default="0.5"/>
  <arg name="auto_finalize_after_bag" default="true"/>
  <arg name="auto_finalize_bag_idle_s" default="0.5"/>
  <arg name="auto_shutdown_after_bag_complete" default="true"/>
  <arg name="save_map_service_name" default="/lio_sam/save_map"/>
  <arg name="save_map_service_timeout_s" default="30.0"/>
  <arg name="semantic_lidar_frame_stride" default="1"/>
  <arg name="semantic_point_stride" default="8"/>
  <arg name="semantic_max_lidar_frames" default="100000"/>
  <arg name="sync_on_shutdown" default="true"/>
  <arg name="detach_full_sync_on_shutdown" default="true"/>
  <arg name="shutdown_worker_job_file" default="lio_sam_map_sync_job.json"/>
  <arg name="shutdown_worker_log_file" default="lio_sam_map_sync_worker.log"/>

  <group if="$(arg enable)">
    <node pkg="lio_sam" type="lio_sam_map_sync.py"
          name="lio_sam_map_sync" output="screen" respawn="false">
      <param name="enable" value="$(arg enable)"/>
      <param name="source_dir" value="$(arg source_dir)"/>
      <param name="destination_dir" value="$(arg destination_dir)"/>
      <param name="sync_astar_ref" value="$(arg sync_astar_ref)"/>
      <param name="source_ref_file" value="$(arg source_ref_file)"/>
      <param name="astar_ref_destination_file" value="$(arg astar_ref_destination_file)"/>
      <param name="wait_timeout_s" value="$(arg wait_timeout_s)"/>
      <param name="poll_period_s" value="$(arg poll_period_s)"/>
      <param name="stable_checks" value="$(arg stable_checks)"/>
      <param name="delete_extra" value="$(arg delete_extra)"/>
      <param name="copy_on_start" value="$(arg copy_on_start)"/>
      <param name="extend_existing_map" value="$(arg extend_existing_map)"/>
      <param name="extension_backup_dir" value="$(arg extension_backup_dir)"/>
      <param name="extension_voxel_leaf_size" value="$(arg extension_voxel_leaf_size)"/>
      <param name="extension_keep_existing_ref" value="$(arg extension_keep_existing_ref)"/>
      <rosparam param="extension_merge_pcd_files">
        ["GlobalMap.pcd", "CornerMap.pcd", "SurfMap.pcd"]
      </rosparam>
      <rosparam param="extension_preserve_files">
        ["map_reference_coordinate.csv"]
      </rosparam>
      <param name="export_global_map_2d_pcd" value="$(arg export_global_map_2d_pcd)"/>
      <param name="global_map_input_file" value="$(arg global_map_input_file)"/>
      <param name="global_map_2d_output" value="$(arg global_map_2d_output)"/>
      <param name="global_map_2d_z_value" value="$(arg global_map_2d_z_value)"/>
      <param name="global_map_2d_binary_output" value="$(arg global_map_2d_binary_output)"/>
      <param name="global_map_2d_xy_leaf_size" value="$(arg global_map_2d_xy_leaf_size)"/>
      <param name="generate_semantic_sidewalk" value="$(arg generate_semantic_sidewalk)"/>
      <param name="semantic_sidewalk_output_dir" value="$(arg semantic_sidewalk_output_dir)"/>
      <param name="semantic_state_output" value="$(arg semantic_state_output)"/>
      <param name="semantic_drivable_state_output" value="$(arg semantic_drivable_state_output)"/>
      <param name="semantic_global_drivable_state_file" value="$(arg semantic_global_drivable_state_file)"/>
      <param name="semantic_source_bag" value="$(arg semantic_source_bag)"/>
      <param name="semantic_auto_detect_source_bag" value="$(arg semantic_auto_detect_source_bag)"/>
      <param name="semantic_detect_bag_poll_period_s" value="$(arg semantic_detect_bag_poll_period_s)"/>
      <param name="auto_finalize_after_bag" value="$(arg auto_finalize_after_bag)"/>
      <param name="auto_finalize_bag_idle_s" value="$(arg auto_finalize_bag_idle_s)"/>
      <param name="auto_shutdown_after_bag_complete" value="$(arg auto_shutdown_after_bag_complete)"/>
      <param name="save_map_service_name" value="$(arg save_map_service_name)"/>
      <param name="save_map_service_timeout_s" value="$(arg save_map_service_timeout_s)"/>
      <param name="semantic_lidar_frame_stride" value="$(arg semantic_lidar_frame_stride)"/>
      <param name="semantic_point_stride" value="$(arg semantic_point_stride)"/>
      <param name="semantic_max_lidar_frames" value="$(arg semantic_max_lidar_frames)"/>
      <param name="sync_on_shutdown" value="$(arg sync_on_shutdown)"/>
      <param name="detach_full_sync_on_shutdown" value="$(arg detach_full_sync_on_shutdown)"/>
      <param name="shutdown_worker_job_file" value="$(arg shutdown_worker_job_file)"/>
      <param name="shutdown_worker_log_file" value="$(arg shutdown_worker_log_file)"/>
    </node>
  </group>
</launch>
