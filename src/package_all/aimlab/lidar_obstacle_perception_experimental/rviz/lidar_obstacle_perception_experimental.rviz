Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
    Tree Height: 520
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.4
      Value: true
    - Class: rviz/PointCloud2
      Name: Input Cloud
      Enabled: true
      Topic: /lio_localizer/localization/cloud_deskewed
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 220; 220; 220
      Alpha: 0.25
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz/PointCloud2
      Name: Ground Cloud
      Enabled: true
      Topic: /experimental/lidar_obstacle_perception/ground_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 80; 180; 80
      Alpha: 0.50
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz/PointCloud2
      Name: Non Ground Cloud
      Enabled: false
      Topic: /experimental/lidar_obstacle_perception/non_ground_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 230; 180; 40
      Alpha: 0.50
      Use Fixed Frame: true
      Selectable: true
      Value: false
    - Class: rviz/PointCloud2
      Name: Static Obstacle Cloud
      Enabled: true
      Topic: /experimental/lidar_obstacle_perception/static_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 50; 180; 255
      Alpha: 0.90
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz/PointCloud2
      Name: Dynamic Obstacle Cloud
      Enabled: true
      Topic: /experimental/lidar_obstacle_perception/dynamic_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.07
      Color Transformer: FlatColor
      Color: 255; 70; 60
      Alpha: 1.00
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Dynamic Markers
      Marker Topic: /experimental/lidar_obstacle_perception/dynamic_markers
      Namespaces:
        dynamic_boxes: true
        dynamic_labels: true
        dynamic_velocity: true
      Queue Size: 10
      Value: true
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Local Obstacle Grid
      Topic: /experimental/lidar_obstacle_perception/local_obstacle_grid
      Unreliable: false
      Use Timestamp: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 22
      X: 0
      Y: 0
Window Geometry:
  Height: 1080
  Width: 1600
  X: 100
  Y: 40
