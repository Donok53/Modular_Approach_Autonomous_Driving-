Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
    Tree Height: 520
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.35
      Value: true
    - Class: rviz/PointCloud2
      Name: Raw LiDAR
      Enabled: true
      Topic: /ouster/points
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 210; 210; 210
      Alpha: 0.18
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz/PointCloud2
      Name: Ground Cloud
      Enabled: true
      Topic: /experimental/lidar_obstacle_perception/ground_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 60; 180; 75
      Alpha: 0.55
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz/PointCloud2
      Name: Non Ground Cloud
      Enabled: true
      Topic: /experimental/lidar_obstacle_perception/non_ground_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 170; 40
      Alpha: 0.95
      Use Fixed Frame: true
      Selectable: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: os_sensor
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 22
      X: 0
      Y: 0
Window Geometry:
  Height: 1080
  Width: 1600
  X: 100
  Y: 40
