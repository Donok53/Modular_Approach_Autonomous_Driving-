    <arg name="debug_stop_logging" default="true"/>
    <arg name="debug_dwa_stats" default="true"/>
    <arg name="stop_log_period_s" default="1.0"/>

    <node unless="$(arg follow_global_path_only)" pkg="dynamic_window_approach" type="active_path_mux.py" name="active_path_mux" output="screen" respawn="false">
