<launch>
    <arg name="pose_topic" default="/lio_localizer/odometry/optimization"/>
    <arg name="planning_pose_topic" default="/lio_localizer/odometry/planning"/>
    <arg name="pose_filter_twist_topic" default="/lio_localizer/odometry/lidar_incremental"/>
    <arg name="pose_filter_twist_linear_frame" default="world"/>
    <arg name="pose_filter_twist_timeout_s" default="0.30"/>
    <arg name="pose_filter_output_child_frame_id" default="base_link"/>
    <arg name="enable_pose_filter" default="true"/>
    <arg name="pose_filter_forward_tau_s" default="0.18"/>
    <arg name="pose_filter_lateral_tau_s" default="0.70"/>
    <arg name="pose_filter_turning_lateral_tau_s" default="0.20"/>
    <arg name="pose_filter_yaw_tau_s" default="0.45"/>
    <arg name="pose_filter_turning_yaw_tau_s" default="0.18"/>
    <arg name="pose_filter_twist_tau_s" default="0.25"/>
    <arg name="pose_filter_lateral_deadband_m" default="0.03"/>
    <arg name="pose_filter_yaw_deadband_deg" default="1.5"/>
    <arg name="pose_filter_straight_speed_min_mps" default="0.10"/>
    <arg name="pose_filter_turning_yaw_rate_threshold_rps" default="0.20"/>
    <arg name="pose_filter_turning_yaw_error_deg" default="10.0"/>
    <arg name="pose_filter_max_straight_lateral_correction_mps" default="0.18"/>

    <group if="$(arg enable_pose_filter)">
        <node pkg="dynamic_window_approach" type="planning_odom_filter.py" name="planning_odom_filter" output="screen" respawn="false">
            <param name="input_topic" value="$(arg pose_topic)"/>
            <param name="twist_topic" value="$(arg pose_filter_twist_topic)"/>
            <param name="twist_linear_frame" value="$(arg pose_filter_twist_linear_frame)"/>
            <param name="output_topic" value="$(arg planning_pose_topic)"/>
            <param name="twist_timeout_s" value="$(arg pose_filter_twist_timeout_s)"/>
            <param name="output_child_frame_id" value="$(arg pose_filter_output_child_frame_id)"/>
            <param name="forward_tau_s" value="$(arg pose_filter_forward_tau_s)"/>
            <param name="lateral_tau_s" value="$(arg pose_filter_lateral_tau_s)"/>
            <param name="turning_lateral_tau_s" value="$(arg pose_filter_turning_lateral_tau_s)"/>
            <param name="yaw_tau_s" value="$(arg pose_filter_yaw_tau_s)"/>
            <param name="turning_yaw_tau_s" value="$(arg pose_filter_turning_yaw_tau_s)"/>
            <param name="twist_tau_s" value="$(arg pose_filter_twist_tau_s)"/>
            <param name="lateral_deadband_m" value="$(arg pose_filter_lateral_deadband_m)"/>
            <param name="yaw_deadband_deg" value="$(arg pose_filter_yaw_deadband_deg)"/>
            <param name="straight_speed_min_mps" value="$(arg pose_filter_straight_speed_min_mps)"/>
            <param name="turning_yaw_rate_threshold_rps" value="$(arg pose_filter_turning_yaw_rate_threshold_rps)"/>
            <param name="turning_yaw_error_deg" value="$(arg pose_filter_turning_yaw_error_deg)"/>
            <param name="max_straight_lateral_correction_mps" value="$(arg pose_filter_max_straight_lateral_correction_mps)"/>
        </node>
    </group>
    <arg name="pointcloud_topic" default="/ouster/points"/>
    <arg name="cloud_tracker_pointcloud_topic" default="$(arg pointcloud_topic)"/>
    <arg name="obstacle_pointcloud_topic" default="$(arg pointcloud_topic)"/>
    <arg name="use_drivable_grid" default="true"/>
    <arg name="drivable_grid_topic" default="/lio_sam/drivable_area/grid"/>
    <arg name="grid_unknown_is_occupied" default="true"/>
    <arg name="global_path_topic" default="/astar/path"/>
    <arg name="local_path_topic" default="/planning/local_path"/>
    <arg name="avoidance_path_topic" default="/planning/avoidance_path"/>
    <arg name="path_mode_topic" default="/planning/path_mode"/>
    <arg name="active_path_topic" default="/planning/active_path"/>
    <arg name="active_path_viz_topic" default="/planning/active_path_viz"/>
    <arg name="tracking_reference_topic" default="/planning/tracking_reference_path"/>
    <arg name="use_local_path_fallback" default="false"/>
    <arg name="path_history_topic" default="/planning/path_history"/>
    <arg name="travel_history_topic" default="/planning/travel_history"/>
    <arg name="behavior_cmd_topic" default="/planning/behavior_cmd"/>
    <arg name="tracked_objects_topic" default="/perception/tracked_objects"/>
    <arg name="enable_tracked_objects_marker_viz" default="true"/>
    <arg name="tracked_objects_marker_topic" default="/perception/tracked_objects_markers"/>
    <arg name="dynamic_risk_grid_topic" default="/planning/dynamic_risk_grid"/>
    <arg name="enable_cloud_tracker" default="true"/>
    <arg name="enable_dynamic_risk_manager" default="true"/>
    <arg name="enable_local_replanner" default="false"/>
    <arg name="follow_global_path_only" default="true"/>
    <arg name="use_dynamic_risk_grid" default="true"/>
    <arg name="use_direct_goal" default="false"/>
    <arg name="direct_goal_topic" default="/move_base_simple/goal"/>
    <arg name="direct_goal_timeout_s" default="0.0"/>
    <arg name="direct_goal_refresh_distance_m" default="0.05"/>
    <arg name="direct_goal_refresh_yaw_deg" default="5.0"/>
    <arg name="goal_tolerance_m" default="0.35"/>
    <arg name="snap_search_radius_cells" default="30"/>
    <arg name="freeze_path_on_first_plan" default="true"/>
    <arg name="smooth_path_line_of_sight" default="true"/>
    <arg name="smooth_avoidance_line_of_sight" default="true"/>
    <arg name="max_los_segment_m" default="1.0"/>
    <arg name="published_path_spacing_m" default="0.25"/>
    <arg name="path_history_max_paths" default="12"/>
    <arg name="replan_hz" default="3.0"/>
    <arg name="lookahead_m" default="4.0"/>
    <arg name="allow_best_effort_path" default="true"/>
    <arg name="best_effort_max_goal_gap_m" default="0.60"/>
    <arg name="enable_avoidance_path" default="false"/>
    <arg name="use_pointcloud_obstacle_cost" default="false"/>
    <arg name="obstacle_collision_radius" default="0.0"/>
    <arg name="robot_width_m" default="0.58"/>
    <arg name="robot_length_m" default="0.612"/>
    <arg name="footprint_padding_m" default="0.05"/>
    <arg name="path_blocking_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.16)"/>
    <arg name="near_goal_relaxed_path_blocking_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.02)"/>
    <arg name="grid_only_relaxed_path_blocking_enabled" default="true"/>
    <arg name="grid_only_relaxed_path_blocking_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.02)"/>
    <arg name="path_tracking_only" default="true"/>
    <arg name="path_tracking_speed_cap" default="0.25"/>
    <arg name="path_tracking_steer_filter_gain" default="0.35"/>
    <arg name="lookahead_distance" default="1.00"/>
    <arg name="snap_lat_err" default="0.20"/>
    <arg name="snap_target_ahead_m" default="0.60"/>
    <arg name="tracking_projection_back_window_m" default="0.35"/>
    <arg name="tracking_projection_forward_window_m" default="1.20"/>
    <arg name="tracking_path_smoothing_passes" default="3"/>
    <arg name="path_tracking_yaw_rate_max_deg" default="55.0"/>
    <arg name="path_tracking_in_place_yaw_rate_max_deg" default="45.0"/>
    <arg name="path_tracking_yaw_accel_max_deg" default="180.0"/>
    <arg name="path_tracking_slowdown_yaw_deg" default="40.0"/>
    <arg name="path_tracking_stop_yaw_deg" default="85.0"/>
    <arg name="path_tracking_cte_gain" default="1.2"/>
    <arg name="path_tracking_cte_soft_mps" default="0.25"/>
    <arg name="path_tracking_cte_deadband_m" default="0.03"/>
    <arg name="path_tracking_cte_filter_gain" default="0.25"/>
    <arg name="path_tracking_cte_yaw_cap_deg" default="25.0"/>
    <arg name="path_tracking_heading_filter_gain" default="0.18"/>
    <arg name="path_tracking_goal_bearing_gain" default="0.45"/>
    <arg name="path_tracking_goal_bearing_cap_deg" default="35.0"/>
    <arg name="path_tracking_target_step_m" default="0.18"/>
    <arg name="path_tracking_tangent_window_m" default="0.60"/>
    <arg name="path_tracking_crawl_speed" default="0.10"/>
    <arg name="path_tracking_large_yaw_crawl_speed" default="0.07"/>
    <arg name="final_approach_window_m" default="2.5"/>
    <arg name="final_speed_k" default="0.75"/>
    <arg name="final_speed_min" default="0.22"/>
    <arg name="path_tracking_stop_distance_m" default="0.80"/>
    <arg name="path_tracking_goal_yaw_rate_max_deg" default="25.0"/>
    <arg name="path_tracking_drivable_ignore_start_distance_m" default="0.45"/>
    <arg name="path_tracking_recovery_ignore_start_distance_m" default="0.90"/>
    <arg name="rotate_only_deg" default="110.0"/>
    <arg name="rotate_exit_deg" default="40.0"/>
    <arg name="rotate_reentry_cooldown_s" default="4.0"/>
    <arg name="near_goal_no_rotate_m" default="1.5"/>
    <arg name="forward_motion_deadband" default="0.01"/>
    <arg name="min_forward_cmd" default="0.12"/>
    <arg name="min_forward_cmd_distance" default="0.60"/>
    <arg name="cruise_min_speed" default="0.0"/>
    <arg name="cruise_distance_m" default="2.5"/>
    <arg name="avoidance_hard_stop_distance" default="0.35"/>
    <arg name="use_pointcloud_static_blocking" default="true"/>
    <arg name="pointcloud_static_block_margin_m" default="0.08"/>
    <arg name="pointcloud_cluster_resolution_m" default="0.15"/>
    <arg name="pointcloud_min_cluster_points" default="4"/>
    <arg name="global_obstacle_overlay_downsample" default="1"/>
    <arg name="use_pointcloud_avoidance_trigger" default="false"/>
    <arg name="obstacle_block_margin_m" default="0.30"/>
    <arg name="avoidance_trigger_margin_m" default="0.25"/>
    <arg name="avoidance_trigger_ahead_m" default="4.0"/>
    <arg name="forward_path_obstacle_filter_enabled" default="true"/>
    <arg name="forward_path_obstacle_rear_tolerance_m" default="0.05"/>
    <arg name="risk_block_confirm_cells" default="2"/>
    <arg name="pointcloud_block_confirm_points" default="2"/>
    <arg name="avoidance_hold_s" default="1.5"/>
    <arg name="avoidance_clear_confirm_cycles" default="10"/>
    <arg name="blocked_clear_hold_s" default="0.35"/>
    <arg name="avoidance_branch_backtrack_cells" default="2"/>
    <arg name="avoidance_rejoin_min_distance_m" default="1.4"/>
    <arg name="rejoin_mode_hold_s" default="1.0"/>
    <arg name="blocked_stop_before_avoidance_s" default="0.0"/>
    <arg name="near_goal_block_ignore_distance_m" default="1.0"/>
    <arg name="near_goal_tail_block_ignore_distance_m" default="0.45"/>
    <arg name="near_goal_block_ignore_after_avoidance_s" default="1.0"/>
    <arg name="near_goal_recent_avoidance_release_distance_m" default="0.30"/>
    <arg name="allow_avoidance_reuse_on_no_solution" default="false"/>
    <arg name="debug_avoidance_logging" default="true"/>
    <arg name="debug_avoidance_log_period_s" default="1.0"/>
    <arg name="static_obstacle_memory_enabled" default="true"/>
    <arg name="static_obstacle_memory_ttl_s" default="1.2"/>
    <arg name="static_obstacle_memory_max_range_m" default="3.0"/>
    <arg name="static_obstacle_memory_max_support" default="8"/>
    <arg name="static_obstacle_memory_max_points" default="40"/>
    <arg name="static_obstacle_memory_persistence_frames" default="3"/>
    <arg name="static_obstacle_memory_lock_ttl_s" default="8.0"/>
    <arg name="static_obstacle_memory_locked_keep_range_m" default="4.5"/>
    <arg name="static_obstacle_memory_blind_zone_radius_m" default="1.40"/>
    <arg name="static_obstacle_memory_blind_zone_hold_ttl_s" default="5.0"/>
    <arg name="known_map_subtraction_enabled" default="true"/>
    <arg name="known_map_subtraction_radius_m" default="0.30"/>
    <arg name="local_blind_zone_guard_enabled" default="true"/>
    <arg name="local_blind_zone_guard_radius_m" default="1.40"/>
    <arg name="local_blind_zone_guard_ttl_s" default="0.45"/>
    <arg name="local_blind_zone_guard_lookahead_m" default="1.0"/>
    <arg name="local_blind_zone_guard_heading_deadband_deg" default="12.0"/>
    <arg name="tracked_object_virtual_obstacles_enabled" default="true"/>
    <arg name="tracked_object_avoidance_enabled" default="false"/>
    <arg name="tracked_object_virtual_max_range_m" default="4.0"/>
    <arg name="tracked_object_prediction_horizon_s" default="1.2"/>
    <arg name="tracked_object_prediction_step_s" default="0.3"/>
    <arg name="tracked_object_prediction_min_speed_mps" default="0.06"/>
    <arg name="tracked_object_virtual_margin_m" default="0.20"/>
    <arg name="near_field_object_memory_enabled" default="true"/>
    <arg name="near_field_object_memory_ttl_s" default="1.5"/>
    <arg name="near_field_object_memory_max_range_m" default="2.5"/>
    <arg name="near_field_object_memory_merge_radius_m" default="0.30"/>
    <arg name="near_field_object_memory_max_points" default="120"/>
    <arg name="enable_global_pointcloud_overlay" default="false"/>
    <arg name="global_obstacle_overlay_topic" default="/planning/global_obstacle_overlay"/>
    <arg name="global_obstacle_overlay_boxes_topic" default="/planning/global_obstacle_overlay_boxes"/>
    <arg name="use_global_obstacle_overlay_boxes_for_stop" default="true"/>
    <arg name="global_obstacle_overlay_stop_locked_only" default="true"/>
    <arg name="global_obstacle_overlay_box_timeout_s" default="1.5"/>
    <arg name="suppress_dynamic_tracked_boxes" default="true"/>
    <arg name="promote_dynamic_tracked_boxes_to_global_overlay" default="false"/>
    <arg name="dynamic_tracked_overlay_confirm_immediately" default="true"/>
    <arg name="global_pointcloud_overlay_persistence_frames" default="3"/>
    <arg name="global_pointcloud_overlay_static_lock_frames" default="5"/>
    <arg name="global_pointcloud_overlay_ttl_s" default="2.0"/>
    <arg name="global_pointcloud_overlay_static_lock_ttl_s" default="30.0"/>
    <arg name="global_pointcloud_overlay_blind_zone_radius_m" default="1.40"/>
    <arg name="global_pointcloud_overlay_blind_zone_hold_ttl_s" default="6.0"/>
    <arg name="global_pointcloud_overlay_merge_radius_m" default="0.25"/>
    <arg name="global_pointcloud_overlay_max_range_m" default="25.0"/>
    <arg name="global_pointcloud_overlay_static_lock_keep_range_m" default="15.0"/>
    <arg name="global_pointcloud_overlay_static_box_margin_m" default="0.08"/>
    <arg name="global_pointcloud_overlay_lookahead_m" default="25.0"/>
    <arg name="global_pointcloud_overlay_corridor_margin_m" default="1.3"/>
    <arg name="global_pointcloud_overlay_forward_min_x_m" default="-0.50"/>
    <arg name="global_pointcloud_overlay_lateral_max_m" default="8.0"/>
    <arg name="global_pointcloud_overlay_near_range_m" default="8.0"/>
    <arg name="global_pointcloud_overlay_mid_range_m" default="16.0"/>
    <arg name="global_pointcloud_overlay_near_min_points" default="4"/>
    <arg name="global_pointcloud_overlay_mid_min_points" default="6"/>
    <arg name="global_pointcloud_overlay_far_min_points" default="8"/>
    <arg name="global_pointcloud_overlay_near_min_cells" default="1"/>
    <arg name="global_pointcloud_overlay_mid_min_cells" default="2"/>
    <arg name="global_pointcloud_overlay_far_min_cells" default="2"/>
    <arg name="global_pointcloud_overlay_near_confirm_frames" default="1"/>
    <arg name="global_pointcloud_overlay_mid_confirm_frames" default="2"/>
    <arg name="global_pointcloud_overlay_far_confirm_frames" default="3"/>
    <arg name="global_pointcloud_overlay_evidence_ttl_s" default="0.9"/>
    <arg name="global_pointcloud_overlay_evidence_resolution_m" default="0.6"/>
    <arg name="global_pointcloud_overlay_max_points" default="200"/>
    <arg name="global_pointcloud_overlay_max_update_hz" default="5.0"/>
    <arg name="global_pointcloud_overlay_far_field_candidate_blocking_enabled" default="true"/>
    <arg name="global_pointcloud_overlay_far_field_candidate_min_distance_m" default="2.5"/>
    <arg name="global_obstacle_overlay_obstacle_max_range_m" default="25.0"/>
    <arg name="enable_planning_slowdown_manager" default="false"/>
    <arg name="planning_slowdown_speed_limit_mps" default="0.12"/>
    <arg name="planning_slowdown_clear_speed_limit_mps" default="99.0"/>
    <arg name="planning_slowdown_hold_s" default="2.0"/>
    <arg name="planning_slowdown_no_path_grace_s" default="0.8"/>
    <arg name="planning_slowdown_publish_hz" default="5.0"/>
    <arg name="planning_slowdown_marker_topic" default="/planning/planning_speed_limit_marker"/>
    <arg name="planning_slowdown_goal_topic" default="/move_base_simple/goal"/>
    <arg name="planning_slowdown_path_is_fallback_topic" default="/astar/path_is_fallback"/>
    <arg name="planning_slowdown_path_blocked_topic" default="/astar/path_blocked"/>
    <arg name="dynamic_speed_thresh_mps" default="0.08"/>
    <arg name="pedestrian_dynamic_speed_thresh_mps" default="0.05"/>
    <arg name="prediction_horizon_s" default="2.2"/>
    <arg name="prediction_step_s" default="0.2"/>
    <arg name="prediction_inflate_m" default="0.55"/>
    <arg name="pedestrian_inflate_extra_m" default="0.20"/>
    <arg name="prediction_speed_inflate_gain_s" default="0.35"/>
    <arg name="pedestrian_prediction_speed_inflate_gain_s" default="0.65"/>
    <arg name="prediction_speed_horizon_gain_s" default="0.80"/>
    <arg name="pedestrian_prediction_speed_horizon_gain_s" default="1.20"/>
    <arg name="prediction_max_horizon_s" default="3.5"/>
    <arg name="front_lateral_stop_m" default="0.95"/>
    <arg name="front_lateral_caution_m" default="1.40"/>
    <arg name="vehicle_stop_ttc_s" default="1.8"/>
    <arg name="pedestrian_stop_ttc_s" default="2.8"/>
    <arg name="caution_ttc_s" default="3.2"/>
    <arg name="pedestrian_caution_speed_mps" default="0.15"/>
    <arg name="rear_vehicle_caution_enabled" default="true"/>
    <arg name="rear_vehicle_max_distance_m" default="8.0"/>
    <arg name="rear_vehicle_lateral_caution_m" default="1.40"/>
    <arg name="rear_vehicle_caution_ttc_s" default="2.8"/>
    <arg name="rear_vehicle_min_closing_speed_mps" default="0.60"/>
    <arg name="rear_vehicle_caution_speed_mps" default="0.30"/>
    <arg name="cross_path_vehicle_caution_enabled" default="true"/>
    <arg name="cross_path_vehicle_forward_distance_m" default="25.0"/>
    <arg name="cross_path_vehicle_lateral_distance_m" default="4.00"/>
    <arg name="cross_path_vehicle_caution_ttc_s" default="3.5"/>
    <arg name="cross_path_vehicle_min_relative_speed_mps" default="0.50"/>
    <arg name="pedestrian_stop_distance_m" default="1.05"/>
    <arg name="pedestrian_caution_distance_m" default="2.00"/>
    <arg name="static_stop_distance_m" default="1.30"/>
    <arg name="static_caution_distance_m" default="2.20"/>
    <arg name="behavior_stop_on_count" default="2"/>
    <arg name="behavior_stop_off_count" default="4"/>
    <arg name="behavior_stop_hold_s" default="0.25"/>
    <arg name="cloud_tracker_max_range_m" default="45.0"/>
    <arg name="cloud_tracker_max_assoc_dist_m" default="1.5"/>
    <arg name="cloud_tracker_dynamic_assoc_bonus_m" default="0.5"/>
    <arg name="cloud_tracker_track_timeout_s" default="2.0"/>
    <arg name="cloud_tracker_downsample" default="2"/>
    <arg name="cloud_tracker_cell_size_m" default="0.25"/>
    <arg name="cloud_tracker_min_points_per_cell" default="2"/>
    <arg name="cloud_tracker_min_cluster_cells" default="3"/>
    <arg name="cloud_tracker_vel_alpha" default="0.25"/>
    <arg name="cloud_tracker_static_speed_thresh_mps" default="0.12"/>
    <arg name="cloud_tracker_dynamic_min_age" default="3"/>
    <arg name="cloud_tracker_publish_static_persons" default="true"/>
    <arg name="cloud_tracker_publish_static_large_obstacles" default="true"/>
    <arg name="cloud_tracker_pedestrian_static_speed_thresh_mps" default="0.06"/>
    <arg name="cloud_tracker_pedestrian_dynamic_min_age" default="2"/>
    <arg name="cloud_tracker_pedestrian_dynamic_min_displacement_m" default="0.14"/>
    <arg name="cloud_tracker_recent_dynamic_hold_s" default="2.5"/>
    <arg name="cloud_tracker_recent_dynamic_velocity_decay" default="0.65"/>
    <arg name="cloud_tracker_position_jitter_m" default="0.16"/>
    <arg name="cloud_tracker_prediction_lead_s" default="0.10"/>
    <arg name="cloud_tracker_pedestrian_prediction_lead_s" default="0.18"/>
    <arg name="cloud_tracker_allow_out_of_grid_clusters" default="true"/>
    <arg name="cloud_tracker_grid_relaxation_distance_m" default="10.0"/>
    <arg name="cloud_tracker_forward_non_drivable_detection_enabled" default="true"/>
    <arg name="cloud_tracker_forward_non_drivable_forward_range_m" default="$(arg cloud_tracker_max_range_m)"/>
    <arg name="cloud_tracker_forward_non_drivable_side_lateral_m" default="6.0"/>
    <arg name="cloud_tracker_forward_non_drivable_rear_margin_m" default="-0.4"/>
    <arg name="cloud_tracker_forward_non_drivable_max_cluster_span_m" default="8.0"/>
    <arg name="cloud_tracker_forward_non_drivable_max_cluster_aspect_ratio" default="6.0"/>
    <arg name="cloud_tracker_free_space_support_radius_m" default="0.35"/>
    <arg name="cloud_tracker_free_space_support_min_cells" default="3"/>
    <arg name="cloud_tracker_far_field_free_space_support_min_cells" default="1"/>
    <arg name="include_static_objects_in_behavior" default="true"/>
    <arg name="include_static_objects_in_risk_grid" default="false"/>
    <arg name="include_large_static_objects_in_risk_grid" default="true"/>
    <arg name="include_static_pedestrians_in_risk_grid" default="true"/>
    <arg name="risk_grid_forward_projection_enabled" default="true"/>
    <arg name="risk_grid_rear_exclusion_m" default="0.20"/>
    <arg name="risk_grid_forward_lateral_m" default="4.00"/>
    <arg name="pedestrian_risk_grid_forward_lateral_extra_m" default="0.60"/>
    <arg name="static_risk_min_span_m" default="1.4"/>
    <arg name="static_risk_min_area_m2" default="1.2"/>
    <arg name="debug_dynamic_risk_logging" default="true"/>
    <arg name="debug_dynamic_risk_log_period_s" default="1.0"/>
    <arg name="emergency_stop_distance" default="0.50"/>
    <arg name="emergency_bin_size_m" default="0.10"/>
    <arg name="emergency_min_close_points" default="2"/>
    <arg name="emergency_immediate_contact_min_points" default="1"/>
    <arg name="emergency_passable_width_m" default="0.62"/>
    <arg name="block_on_count" default="2"/>
    <arg name="block_off_count" default="4"/>
    <arg name="obstacle_consider_side_m" default="0.80"/>
    <arg name="obstacle_consider_back_m" default="-0.15"/>
    <arg name="self_filter_margin_m" default="0.08"/>
    <arg name="near_field_raw_stop_enabled" default="false"/>
