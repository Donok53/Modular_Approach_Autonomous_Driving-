  <arg name="near_goal_block_ignore_distance_m" default="1.20"/>
  <arg name="near_goal_tail_block_ignore_distance_m" default="0.60"/>
  <arg name="near_goal_block_ignore_after_avoidance_s" default="1.0"/>
  <arg name="near_goal_recent_avoidance_release_distance_m" default="0.30"/>
  <arg name="allow_avoidance_reuse_on_no_solution" default="false"/>
