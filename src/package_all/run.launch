  <arg name="use_global_obstacle_overlay_boxes_for_stop" default="false"/>
  <arg name="global_obstacle_overlay_stop_locked_only" default="true"/>
  <arg name="global_obstacle_overlay_box_timeout_s" default="1.5"/>
  <arg name="suppress_dynamic_tracked_boxes" default="false"/>
  <arg name="promote_dynamic_tracked_boxes_to_global_overlay" default="false"/>
  <arg name="dynamic_tracked_overlay_confirm_immediately" default="true"/>
  <arg name="global_obstacle_overlay_threshold" default="50"/>
  <arg name="global_pointcloud_overlay_persistence_frames" default="3"/>
  <arg name="global_pointcloud_overlay_static_lock_frames" default="5"/>
  <arg name="global_pointcloud_overlay_ttl_s" default="1.0"/>
  <arg name="global_pointcloud_overlay_static_lock_ttl_s" default="8.0"/>
  <arg name="global_pointcloud_overlay_blind_zone_radius_m" default="1.40"/>
  <arg name="global_pointcloud_overlay_blind_zone_hold_ttl_s" default="1.5"/>
  <arg name="global_pointcloud_overlay_merge_radius_m" default="0.25"/>
  <arg name="global_pointcloud_overlay_max_range_m" default="$(eval '10.0' if str(arg('localization_environment')).lower() == 'outdoor' else '25.0')"/>
  <arg name="global_pointcloud_overlay_static_lock_keep_range_m" default="15.0"/>
  <arg name="global_pointcloud_overlay_static_box_margin_m" default="0.06"/>
  <arg name="global_pointcloud_overlay_lookahead_m" default="$(eval '8.0' if str(arg('localization_environment')).lower() == 'outdoor' else '25.0')"/>
  <arg name="global_pointcloud_overlay_corridor_margin_m" default="$(eval '0.7' if str(arg('localization_environment')).lower() == 'outdoor' else '1.3')"/>
  <arg name="global_pointcloud_overlay_forward_min_x_m" default="-0.50"/>
  <arg name="global_pointcloud_overlay_lateral_max_m" default="$(eval '3.5' if str(arg('localization_environment')).lower() == 'outdoor' else '8.0')"/>
  <arg name="global_pointcloud_overlay_near_range_m" default="8.0"/>
  <arg name="global_pointcloud_overlay_mid_range_m" default="$(eval '8.0' if str(arg('localization_environment')).lower() == 'outdoor' else '16.0')"/>
  <arg name="global_pointcloud_overlay_near_min_points" default="2"/>
  <arg name="global_pointcloud_overlay_mid_min_points" default="6"/>
  <arg name="global_pointcloud_overlay_far_min_points" default="12"/>
  <arg name="global_pointcloud_overlay_near_min_cells" default="1"/>
  <arg name="global_pointcloud_overlay_mid_min_cells" default="2"/>
  <arg name="global_pointcloud_overlay_far_min_cells" default="3"/>
  <arg name="global_pointcloud_overlay_near_confirm_frames" default="1"/>
  <arg name="global_pointcloud_overlay_mid_confirm_frames" default="2"/>
  <arg name="global_pointcloud_overlay_far_confirm_frames" default="4"/>
  <arg name="global_pointcloud_overlay_caution_enabled" default="true"/>
  <arg name="global_pointcloud_overlay_caution_min_range_m" default="8.0"/>
  <arg name="global_pointcloud_overlay_caution_min_points" default="4"/>
  <arg name="global_pointcloud_overlay_caution_min_cells" default="1"/>
  <arg name="global_pointcloud_overlay_caution_confirm_frames" default="3"/>
  <arg name="global_pointcloud_overlay_evidence_ttl_s" default="0.9"/>
  <arg name="global_pointcloud_overlay_evidence_resolution_m" default="0.6"/>
  <arg name="global_pointcloud_overlay_max_points" default="$(eval '60' if str(arg('localization_environment')).lower() == 'outdoor' else '200')"/>
  <arg name="global_pointcloud_overlay_max_update_hz" default="$(eval '2.0' if str(arg('localization_environment')).lower() == 'outdoor' else '5.0')"/>
  <arg name="global_obstacle_overlay_downsample" default="$(eval '2' if str(arg('localization_environment')).lower() == 'outdoor' else '1')"/>
  <arg name="global_obstacle_overlay_obstacle_max_range_m" default="25.0"/>
  <arg name="enable_planning_slowdown_manager" default="true"/>
  <arg name="planning_slowdown_speed_limit_mps" default="0.65"/>
  <arg name="planning_slowdown_clear_speed_limit_mps" default="99.0"/>
  <arg name="planning_slowdown_hold_s" default="2.0"/>
  <arg name="planning_slowdown_no_path_grace_s" default="0.8"/>
  <arg name="planning_slowdown_caution_timeout_s" default="1.2"/>
  <arg name="planning_slowdown_publish_hz" default="5.0"/>
  <arg name="planning_slowdown_marker_topic" default="/planning/planning_speed_limit_marker"/>
  <arg name="planning_slowdown_path_blocked_topic" default="$(arg path_blocked_topic)"/>
  <arg name="dynamic_speed_thresh_mps" default="0.08"/>
  <arg name="pedestrian_dynamic_speed_thresh_mps" default="0.05"/>
  <arg name="prediction_horizon_s" default="2.2"/>
  <arg name="prediction_step_s" default="0.2"/>
  <arg name="prediction_inflate_m" default="0.55"/>
  <arg name="pedestrian_inflate_extra_m" default="0.20"/>
  <arg name="prediction_speed_inflate_gain_s" default="0.35"/>
  <arg name="pedestrian_prediction_speed_inflate_gain_s" default="0.65"/>
  <arg name="prediction_speed_horizon_gain_s" default="0.80"/>
  <arg name="pedestrian_prediction_speed_horizon_gain_s" default="1.20"/>
  <arg name="prediction_max_horizon_s" default="3.5"/>
  <arg name="front_lateral_stop_m" default="0.95"/>
  <arg name="front_lateral_caution_m" default="1.40"/>
  <arg name="vehicle_stop_ttc_s" default="1.8"/>
  <arg name="pedestrian_stop_ttc_s" default="2.8"/>
  <arg name="caution_ttc_s" default="3.2"/>
  <arg name="pedestrian_caution_speed_mps" default="0.15"/>
  <arg name="rear_vehicle_caution_enabled" default="true"/>
  <arg name="rear_vehicle_max_distance_m" default="8.0"/>
  <arg name="rear_vehicle_lateral_caution_m" default="1.40"/>
  <arg name="rear_vehicle_caution_ttc_s" default="2.8"/>
  <arg name="rear_vehicle_min_closing_speed_mps" default="0.60"/>
  <arg name="rear_vehicle_caution_speed_mps" default="0.30"/>
  <arg name="cross_path_vehicle_caution_enabled" default="true"/>
  <arg name="cross_path_vehicle_forward_distance_m" default="25.0"/>
  <arg name="cross_path_vehicle_lateral_distance_m" default="4.00"/>
  <arg name="cross_path_vehicle_caution_ttc_s" default="3.5"/>
  <arg name="cross_path_vehicle_min_relative_speed_mps" default="0.50"/>
  <arg name="pedestrian_stop_distance_m" default="1.05"/>
  <arg name="pedestrian_caution_distance_m" default="2.00"/>
  <arg name="static_stop_distance_m" default="1.30"/>
  <arg name="static_caution_distance_m" default="2.20"/>
  <arg name="behavior_stop_on_count" default="2"/>
  <arg name="behavior_stop_off_count" default="4"/>
  <arg name="behavior_stop_hold_s" default="0.25"/>
  <arg name="cloud_tracker_max_range_m" default="45.0"/>
  <arg name="cloud_tracker_max_assoc_dist_m" default="1.5"/>
  <arg name="cloud_tracker_dynamic_assoc_bonus_m" default="0.5"/>
  <arg name="cloud_tracker_track_timeout_s" default="2.0"/>
  <arg name="cloud_tracker_downsample" default="2"/>
  <arg name="cloud_tracker_cell_size_m" default="0.25"/>
  <arg name="cloud_tracker_min_points_per_cell" default="2"/>
  <arg name="cloud_tracker_min_cluster_cells" default="3"/>
  <arg name="cloud_tracker_vel_alpha" default="0.25"/>
  <arg name="cloud_tracker_static_speed_thresh_mps" default="0.12"/>
  <arg name="cloud_tracker_dynamic_min_age" default="3"/>
  <arg name="cloud_tracker_publish_static_persons" default="true"/>
  <arg name="cloud_tracker_publish_static_large_obstacles" default="true"/>
  <arg name="cloud_tracker_pedestrian_static_speed_thresh_mps" default="0.06"/>
  <arg name="cloud_tracker_pedestrian_dynamic_min_age" default="2"/>
  <arg name="cloud_tracker_pedestrian_dynamic_min_displacement_m" default="0.14"/>
  <arg name="cloud_tracker_recent_dynamic_hold_s" default="2.5"/>
  <arg name="cloud_tracker_recent_dynamic_velocity_decay" default="0.65"/>
  <arg name="cloud_tracker_position_jitter_m" default="0.16"/>
  <arg name="cloud_tracker_prediction_lead_s" default="0.10"/>
  <arg name="cloud_tracker_pedestrian_prediction_lead_s" default="0.18"/>
  <arg name="cloud_tracker_allow_out_of_grid_clusters" default="true"/>
  <arg name="cloud_tracker_grid_relaxation_distance_m" default="10.0"/>
  <arg name="cloud_tracker_forward_non_drivable_detection_enabled" default="true"/>
  <arg name="cloud_tracker_forward_non_drivable_forward_range_m" default="$(arg cloud_tracker_max_range_m)"/>
  <arg name="cloud_tracker_forward_non_drivable_side_lateral_m" default="6.0"/>
  <arg name="cloud_tracker_forward_non_drivable_rear_margin_m" default="-0.4"/>
  <arg name="cloud_tracker_forward_non_drivable_max_cluster_span_m" default="8.0"/>
  <arg name="cloud_tracker_forward_non_drivable_max_cluster_aspect_ratio" default="6.0"/>
  <arg name="cloud_tracker_free_space_support_radius_m" default="0.35"/>
  <arg name="cloud_tracker_free_space_support_min_cells" default="3"/>
  <arg name="cloud_tracker_far_field_free_space_support_min_cells" default="1"/>
  <arg name="include_static_objects_in_behavior" default="true"/>
  <arg name="include_static_objects_in_risk_grid" default="false"/>
  <arg name="include_large_static_objects_in_risk_grid" default="true"/>
  <arg name="include_static_pedestrians_in_risk_grid" default="true"/>
  <arg name="risk_grid_forward_projection_enabled" default="true"/>
  <arg name="risk_grid_rear_exclusion_m" default="0.20"/>
  <arg name="risk_grid_forward_lateral_m" default="4.00"/>
  <arg name="pedestrian_risk_grid_forward_lateral_extra_m" default="0.60"/>
  <arg name="static_risk_min_span_m" default="1.4"/>
  <arg name="static_risk_min_area_m2" default="1.2"/>
  <arg name="debug_dynamic_risk_logging" default="true"/>
  <arg name="debug_dynamic_risk_log_period_s" default="1.0"/>
  <arg name="enable_emergency_stop" default="true"/>
  <arg name="emergency_stop_distance" default="0.55"/>
  <arg name="emergency_bin_size_m" default="0.10"/>
  <arg name="emergency_min_close_points" default="2"/>
  <arg name="emergency_immediate_contact_min_points" default="1"/>
  <arg name="emergency_passable_width_m" default="$(eval max(float(arg('robot_width_m')) + 0.02, float(arg('robot_width_m')) + 2.0 * float(arg('footprint_padding_m')) - 0.10))"/>
  <arg name="block_on_count" default="2"/>
  <arg name="block_off_count" default="3"/>
  <arg name="obstacle_consider_side_m" default="0.80"/>
  <arg name="obstacle_consider_back_m" default="-0.15"/>
  <arg name="self_filter_margin_m" default="0.08"/>
  <arg name="near_field_raw_stop_enabled" default="true"/>
  <arg name="near_field_raw_stop_topic" default="$(arg pointcloud_topic)"/>
  <arg name="near_field_raw_stop_base_frame" default="$(arg robot_base_frame)"/>
  <arg name="near_field_raw_stop_tf_timeout_s" default="0.02"/>
  <arg name="near_field_raw_stop_tf_fallback_latest" default="true"/>
  <arg name="near_field_raw_stop_allow_raw_frame_on_tf_failure" default="true"/>
  <arg name="near_field_raw_stop_min_x_m" default="0.35"/>
  <arg name="near_field_raw_stop_max_x_m" default="0.75"/>
  <!-- Narrowed from 0.28 to 0.18 m so the safety stop only catches
       obstacles in front of the robot's centre column. Anything beside
       the robot during a sidestep is filtered out (the planner already
       knows about it). 0.18 m is ~60% of the robot half-width, leaving
       a guard band but not the full footprint. -->
  <arg name="near_field_raw_stop_half_width_m" default="0.18"/>
  <arg name="near_field_raw_stop_min_z_m" default="0.08"/>
  <arg name="near_field_raw_stop_max_z_m" default="0.70"/>
  <arg name="near_field_raw_stop_min_points" default="2"/>
  <arg name="near_field_raw_stop_cell_size_m" default="0.12"/>
  <arg name="near_field_raw_stop_min_cells" default="1"/>
  <arg name="near_field_raw_stop_close_override_distance_m" default="$(arg avoidance_hard_stop_distance)"/>
  <arg name="near_field_raw_stop_close_override_half_width_m" default="0.12"/>
  <arg name="near_field_raw_stop_close_override_min_points" default="3"/>
  <arg name="near_field_raw_stop_close_override_min_cells" default="2"/>
  <arg name="near_field_raw_stop_downsample" default="1"/>
  <arg name="near_field_raw_stop_max_update_hz" default="$(eval '8.0' if str(arg('localization_environment')).lower() == 'outdoor' else '0.0')"/>
  <arg name="near_field_raw_stop_on_count" default="2"/>
  <arg name="near_field_raw_stop_off_count" default="2"/>
  <arg name="near_field_raw_stop_timeout_s" default="0.60"/>
  <arg name="near_field_raw_stop_hold_s" default="0.50"/>
  <arg name="near_field_raw_stop_marker_topic" default="/planning/near_field_stop_marker"/>
  <arg name="near_field_raw_stop_hit_cloud_topic" default="/planning/near_field_stop_hits"/>
  <arg name="near_field_raw_stop_log_period_s" default="0.5"/>
  <arg name="emergency_bypass_enabled" default="true"/>
  <arg name="emergency_bypass_preview_m" default="1.60"/>
  <arg name="emergency_bypass_target_lateral_m" default="0.06"/>
  <arg name="emergency_bypass_bearing_deg" default="4.5"/>
  <arg name="emergency_bypass_yaw_err_deg" default="6.0"/>
  <arg name="emergency_bypass_clearance_margin_m" default="0.05"/>
  <arg name="active_avoidance_bypass_clearance_m" default="$(eval '0.20' if str(arg('localization_environment')).lower() == 'outdoor' else '0.18')"/>
  <arg name="emergency_bypass_goal_window_m" default="0.60"/>
  <arg name="emergency_bypass_speed_limit_mps" default="0.08"/>
  <arg name="emergency_bypass_clearance_floor_m" default="0.15"/>
  <arg name="emergency_bypass_max_path_age_s" default="0.70"/>
  <arg name="emergency_bypass_max_lateral_dev_m" default="0.10"/>
  <arg name="post_stop_rotation_min_clearance_m" default="$(arg emergency_bypass_clearance_floor_m)"/>
  <arg name="post_stop_rotation_start_clearance_m" default="$(eval float(arg('emergency_bypass_clearance_floor_m')) + 0.03)"/>
  <arg name="obstacle_ignore_traj_steps" default="3"/>
  <arg name="use_auto_osm" default="$(eval 'false' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'true')"/>
  <arg name="default_osm_file" default="$(find astar_map)/map/test_trajectory.osm"/>
  <arg name="auto_osm_file" default="$(find astar_map)/map/auto_trajectory$(arg map_profile_suffix).osm"/>
  <arg name="astar_ref_file" default="$(arg localizer_map_bundle_dir)/map_reference_coordinate.csv"/>
  <arg name="enable_monitoring_asset_bundle" default="$(eval 'false' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'true')"/>
  <arg name="monitoring_asset_bundle_dir" default="$(find lio_localizer)/../../monitoring_delivery/latest$(arg map_profile_suffix)"/>
  <arg name="monitoring_bundle_source_dir" default="$(arg localizer_map_bundle_dir)"/>
  <arg name="monitoring_bundle_osm_file" default="$(eval arg('auto_osm_file') if arg('use_auto_osm') == 'true' else arg('default_osm_file'))"/>
  <arg name="monitoring_bundle_drivable_state_file" default="$(arg runtime_drivable_state_file)"/>

  <group if="$(arg use_lio_sam)">
    <include file="$(find lio_sam)/launch/run-robot.launch">
      <arg name="real_mode" value="$(arg real_mode)"/>
      <arg name="environment" value="$(arg localization_environment)"/>
    </include>
  </group>
  <group unless="$(arg use_lio_sam)">
    <include file="$(find lio_localizer)/launch/run-robot.launch">
      <arg name="real_mode" value="$(arg real_mode)"/>
      <arg name="map_relative_path" value="$(arg localizer_map_relative_path)"/>
      <arg name="global_map_2d_background_pcd" value="$(arg localizer_map_bundle_dir)/GlobalMap2D.pcd"/>
      <arg name="drivable_area_state_file_path" value="$(arg runtime_drivable_state_file)"/>
      <arg name="environment" value="$(arg localization_environment)"/>
      <arg name="enable_drivable_area" value="$(arg enable_localizer_drivable_area)"/>
      <arg name="enable_drivable_area_2d_editor" value="$(arg enable_localizer_drivable_area_2d_editor)"/>
      <arg name="enable_global_map_2d_background" value="$(arg enable_localizer_global_map_2d_background)"/>
      <arg name="enable_global_map_2d_edit_plane" value="$(arg enable_localizer_global_map_2d_edit_plane)"/>
      <arg name="global_map_2d_reload_period_s" value="$(arg localizer_global_map_2d_reload_period_s)"/>
      <arg name="enable_rviz" value="$(arg enable_rviz)"/>
      <arg name="rviz_config_file" value="$(find lio_localizer)/launch/include/config/rviz_with_local_planner.rviz"/>
      <arg name="use_internal_initial_pose" value="$(arg localizer_use_internal_initial_pose)"/>
      <arg name="initial_pose_x_m" value="$(arg localizer_initial_pose_x_m)"/>
      <arg name="initial_pose_y_m" value="$(arg localizer_initial_pose_y_m)"/>
      <arg name="initial_pose_z_m" value="$(arg localizer_initial_pose_z_m)"/>
      <arg name="initial_pose_roll_deg" value="$(arg localizer_initial_pose_roll_deg)"/>
      <arg name="initial_pose_pitch_deg" value="$(arg localizer_initial_pose_pitch_deg)"/>
      <arg name="initial_pose_yaw_deg" value="$(arg localizer_initial_pose_yaw_deg)"/>
    </include>
  </group>

  <node if="$(arg enable_monitoring_asset_bundle)" pkg="lio_sam" type="lio_sam_map_sync.py"
        name="monitoring_asset_bundle" output="screen" respawn="false">
    <param name="enable" value="$(arg enable_monitoring_asset_bundle)"/>
    <param name="source_dir" value="$(arg monitoring_bundle_source_dir)"/>
    <param name="destination_dir" value="$(arg monitoring_asset_bundle_dir)"/>
    <param name="sync_astar_ref" value="false"/>
    <param name="wait_timeout_s" value="0.0"/>
    <param name="poll_period_s" value="0.5"/>
    <param name="stable_checks" value="1"/>
    <param name="delete_extra" value="true"/>
    <param name="copy_on_start" value="true"/>
    <param name="write_manifest" value="true"/>
    <param name="manifest_file" value="asset_manifest.json"/>
    <param name="export_drivable_area_pcd" value="true"/>
    <param name="export_global_map_2d_pcd" value="true"/>
    <param name="global_map_input_file" value="GlobalMap.pcd"/>
    <param name="global_map_2d_output" value="GlobalMap2D.pcd"/>
    <param name="global_map_2d_z_value" value="0.0"/>
    <param name="global_map_2d_binary_output" value="true"/>
    <param name="global_map_2d_xy_leaf_size" value="0.11"/>
    <param name="write_asset_descriptions" value="true"/>
    <param name="asset_readme_file" value="README_static_assets.txt"/>
    <param name="drivable_area_state_file" value="$(arg monitoring_bundle_drivable_state_file)"/>
    <param name="drivable_area_pcd_output" value="DrivableAreaMap.pcd"/>
    <param name="drivable_area_risk_pcd_output" value="DrivableAreaRiskMap.pcd"/>
    <rosparam param="extra_files" subst_value="true">
      [
        "$(arg monitoring_bundle_osm_file)::auto_trajectory.osm",
        "$(arg monitoring_bundle_drivable_state_file)::lio_sam_drivable_area_state.json"
      ]
    </rosparam>
  </node>

  <node if="$(arg enable_robot_send)" pkg="wave" type="robot_send.py" name="robot_send" output="screen" respawn="false"/>
  <node if="$(arg enable_wave_cmd_bridge)" pkg="wave" type="wave_topic.py" name="wave_topic" output="screen" respawn="false">
    <param name="port_name" value="$(arg wave_port_name)"/>
    <param name="baud_rate" value="$(arg wave_baud_rate)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="linear_scale" value="$(arg wave_linear_scale)"/>
    <param name="angular_scale" value="$(arg wave_angular_scale)"/>
    <param name="emergency_stop_topic" value="$(arg emergency_stop_topic)"/>
    <param name="emergency_preserve_angular" value="$(arg wave_emergency_preserve_angular)"/>
    <param name="emergency_angular_limit_rps" value="$(arg wave_emergency_angular_limit_rps)"/>
  </node>

  <node if="$(arg publish_os_sensor_static_tf)"
        pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_os_sensor_static_tf"
        args="$(arg os_sensor_x_m) $(arg os_sensor_y_m) $(arg os_sensor_z_m) 0 0 0 1 $(arg os_sensor_parent_frame) $(arg os_sensor_frame)"/>

  <group if="$(arg enable_linefit_ground_filter_for_planning)">
    <include file="$(find lidar_obstacle_perception_experimental)/launch/linefit_ground_removal_debug.launch">
      <arg name="pointcloud_topic" value="$(arg linefit_pointcloud_topic)"/>
      <arg name="imu_topic" value="$(arg imu_topic)"/>
      <arg name="raw_frame" value="$(arg linefit_raw_frame)"/>
      <arg name="gravity_frame" value="$(arg linefit_gravity_frame)"/>
      <arg name="enable_rviz" value="false"/>
      <arg name="ground_cloud_topic" value="$(arg linefit_ground_cloud_topic)"/>
      <arg name="non_ground_cloud_topic" value="$(arg linefit_selector_non_ground_cloud_topic)"/>
      <arg name="mode_topic" value="$(arg linefit_mode_topic)"/>
      <arg name="sensor_height_m" value="$(arg linefit_sensor_height_m)"/>
      <arg name="r_min_m" value="$(arg linefit_r_min_m)"/>
      <arg name="r_max_m" value="$(arg linefit_r_max_m)"/>
      <arg name="max_dist_to_line" value="$(arg linefit_max_dist_to_line)"/>
      <arg name="max_fit_error" value="$(arg linefit_max_fit_error)"/>
      <arg name="long_threshold" value="$(arg linefit_long_threshold)"/>
      <arg name="line_search_angle" value="$(arg linefit_line_search_angle)"/>
      <arg name="flat_max_slope" value="$(arg linefit_flat_max_slope)"/>
      <arg name="flat_max_start_height" value="$(arg linefit_flat_max_start_height)"/>
      <arg name="flat_max_long_height" value="$(arg linefit_flat_max_long_height)"/>
      <arg name="slope_max_slope" value="$(arg linefit_slope_max_slope)"/>
      <arg name="slope_max_start_height" value="$(arg linefit_slope_max_start_height)"/>
      <arg name="slope_max_long_height" value="$(arg linefit_slope_max_long_height)"/>
      <arg name="enter_slope_pitch_deg" value="$(arg linefit_enter_slope_pitch_deg)"/>
      <arg name="exit_slope_pitch_deg" value="$(arg linefit_exit_slope_pitch_deg)"/>
      <arg name="n_threads" value="$(arg linefit_n_threads)"/>
    </include>

    <node if="$(arg enable_linefit_self_filter)"
          pkg="lidar_obstacle_perception_experimental"
          type="self_footprint_cloud_filter.py"
          name="linefit_self_footprint_cloud_filter"
          output="screen"
          respawn="false">
