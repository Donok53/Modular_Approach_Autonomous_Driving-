<launch>
  <arg name="use_sim_time" default="false"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>
  <arg name="use_lio_sam" default="false"/>
  <arg name="real_mode" default="false"/>
  <arg name="map_profile_name" default="$(eval 'real' if str(arg('real_mode')).lower() == 'true' else 'test')"/>
  <arg name="map_profile_suffix" default="$(eval '_real' if str(arg('real_mode')).lower() == 'true' else '')"/>
  <arg name="localizer_map_relative_path" default="$(eval '/map/real' if str(arg('real_mode')).lower() == 'true' else '/map/test')"/>
  <arg name="localizer_map_bundle_dir" default="$(find lio_localizer)/map/$(arg map_profile_name)"/>
  <arg name="runtime_drivable_state_file" default="$(env HOME)/.ros/lio_sam_drivable_area_state$(arg map_profile_suffix).json"/>
  <arg name="localization_environment" default="indoor"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="enable_localizer_drivable_area" default="true"/>
  <arg name="enable_localizer_drivable_area_2d_editor" default="false"/>
  <arg name="enable_lio_sam_drivable_area_2d_editor" default="false"/>
  <arg name="enable_localizer_global_map_2d_background" default="true"/>
  <arg name="enable_localizer_global_map_2d_edit_plane" default="true"/>
  <arg name="localizer_global_map_2d_reload_period_s" default="2.0"/>
  <arg name="localizer_use_internal_initial_pose" default="false"/>
  <arg name="localizer_initial_pose_x_m" default="0.0"/>
  <arg name="localizer_initial_pose_y_m" default="0.0"/>
  <arg name="localizer_initial_pose_z_m" default="0.0"/>
  <arg name="localizer_initial_pose_roll_deg" default="0.0"/>
  <arg name="localizer_initial_pose_pitch_deg" default="0.0"/>
  <arg name="localizer_initial_pose_yaw_deg" default="160.6"/>
  <arg name="pose_topic" default="$(eval '/lio_sam/mapping/odometry' if arg('use_lio_sam') == 'true' else 'lio_localizer/odometry/optimization')"/>
  <arg name="pose_filter_twist_topic" default="$(eval '/lio_sam/mapping/odometry_incremental' if arg('use_lio_sam') == 'true' else '/lio_localizer/odometry/lidar_incremental')"/>
  <arg name="pose_filter_twist_linear_frame" default="world"/>
  <arg name="pose_filter_twist_timeout_s" default="0.30"/>
  <arg name="pose_filter_output_child_frame_id" default="base_link"/>
  <arg name="pointcloud_topic" default="/ouster/points"/>
  <arg name="imu_topic" default="/imu/data"/>
  <arg name="cloud_tracker_pointcloud_topic" default="$(eval '/lio_sam/deskew/cloud_deskewed' if arg('use_lio_sam') == 'true' else '/lio_localizer/localization/cloud_deskewed')"/>
  <arg name="use_drivable_grid" default="true"/>
  <arg name="drivable_grid_topic" default="/lio_sam/drivable_area/grid"/>
  <arg name="grid_unknown_is_occupied" default="true"/>
  <arg name="enable_cloud_tracker" default="false"/>
  <arg name="enable_dynamic_risk_manager" default="false"/>
  <arg name="enable_local_replanner" default="false"/>
  <arg name="follow_global_path_only" default="true"/>
  <arg name="use_dynamic_risk_grid" default="false"/>
  <arg name="tracked_objects_topic" default="/perception/tracked_objects"/>
  <arg name="enable_tracked_objects_marker_viz" default="false"/>
  <arg name="behavior_cmd_topic" default="/planning/behavior_cmd"/>
  <arg name="path_blocked_topic" default="/astar/path_blocked"/>
  <arg name="emergency_stop_topic" default="/planning/emergency_stop"/>
  <arg name="local_path_topic" default="/planning/local_path"/>
  <arg name="avoidance_path_topic" default="/planning/avoidance_path"/>
  <arg name="active_path_topic" default="/planning/active_path"/>
  <arg name="active_path_viz_topic" default="/planning/active_path_viz"/>
  <arg name="tracking_reference_topic" default="/planning/tracking_reference_path"/>
  <arg name="use_local_path_fallback" default="false"/>
  <arg name="path_history_topic" default="/planning/path_history"/>
  <arg name="travel_history_topic" default="/planning/travel_history"/>
  <arg name="dynamic_risk_grid_topic" default="/planning/dynamic_risk_grid"/>
  <arg name="use_free_area_goal" default="false"/>
  <arg name="free_area_goal_topic" default="/move_base_simple/goal"/>
  <arg name="enable_crossing_portal_manager" default="false"/>
  <arg name="crossing_portal_config_file" default="$(find dynamic_window_approach)/config/crossing_portals.yaml"/>
  <arg name="crossing_portal_odom_topic" default="$(arg pose_topic)"/>
  <arg name="crossing_portal_goal_topic" default="/planning/crossing_direct_goal"/>
  <arg name="crossing_portal_status_topic" default="/planning/crossing_portal_status"/>
  <arg name="crossing_portal_publish_hz" default="5.0"/>
  <arg name="crossing_portal_direct_goal_timeout_s" default="1.0"/>
  <arg name="crossing_portal_direct_goal_refresh_distance_m" default="0.20"/>
  <arg name="crossing_portal_direct_goal_refresh_yaw_deg" default="8.0"/>
  <arg name="freeze_path_on_first_plan" default="true"/>
  <arg name="smooth_path_line_of_sight" default="true"/>
  <arg name="smooth_avoidance_line_of_sight" default="true"/>
  <arg name="max_los_segment_m" default="4.0"/>
  <arg name="published_path_spacing_m" default="0.25"/>
  <arg name="path_history_max_paths" default="12"/>
  <arg name="local_replan_hz" default="3.0"/>
  <arg name="local_replan_lookahead_m" default="4.0"/>
  <arg name="allow_best_effort_local_path" default="true"/>
  <arg name="best_effort_max_goal_gap_m" default="0.60"/>
  <arg name="enable_avoidance_path" default="false"/>
  <arg name="enable_graph_planner" default="true"/>
  <arg name="enable_robot_send" default="false"/>
  <arg name="enable_wave_cmd_bridge" default="false"/>
  <arg name="wave_port_name" default=""/>
  <arg name="wave_baud_rate" default="19200"/>
  <arg name="wave_linear_scale" default="1.0"/>
  <arg name="wave_angular_scale" default="1.0"/>
  <arg name="local_planner_mode" default="custom"/>
  <arg name="enable_linefit_ground_filter_for_planning" default="true"/>
  <arg name="enable_linefit_self_filter" default="true"/>
  <arg name="linefit_pointcloud_topic" default="$(arg cloud_tracker_pointcloud_topic)"/>
  <arg name="linefit_raw_frame" default="base_link"/>
  <arg name="linefit_gravity_frame" default="base_link_gravity"/>
  <arg name="linefit_ground_cloud_topic" default="/planning/linefit_ground/ground_cloud"/>
  <arg name="linefit_raw_non_ground_cloud_topic" default="/planning/linefit_ground/non_ground_cloud_raw"/>
  <arg name="linefit_non_ground_cloud_topic" default="/planning/linefit_ground/non_ground_cloud"/>
  <arg name="linefit_selector_non_ground_cloud_topic" default="$(eval arg('linefit_raw_non_ground_cloud_topic') if str(arg('enable_linefit_self_filter')).lower() == 'true' else arg('linefit_non_ground_cloud_topic'))"/>
  <arg name="enable_planning_self_filter" default="true"/>
  <arg name="linefit_mode_topic" default="/planning/linefit_ground/mode"/>
  <arg name="linefit_sensor_height_m" default="0.525"/>
  <arg name="linefit_r_min_m" default="0.10"/>
  <arg name="linefit_r_max_m" default="25.0"/>
  <arg name="linefit_max_dist_to_line" default="0.08"/>
  <arg name="linefit_max_fit_error" default="0.08"/>
  <arg name="linefit_long_threshold" default="1.5"/>
  <arg name="linefit_line_search_angle" default="0.20"/>
  <arg name="linefit_flat_max_slope" default="0.45"/>
  <arg name="linefit_flat_max_start_height" default="0.32"/>
  <arg name="linefit_flat_max_long_height" default="0.18"/>
  <arg name="linefit_slope_max_slope" default="0.58"/>
  <arg name="linefit_slope_max_start_height" default="0.40"/>
  <arg name="linefit_slope_max_long_height" default="0.24"/>
  <arg name="linefit_enter_slope_pitch_deg" default="4.5"/>
  <arg name="linefit_exit_slope_pitch_deg" default="3.0"/>
  <arg name="linefit_self_filter_padding_m" default="0.06"/>
  <arg name="linefit_self_filter_center_x_m" default="0.0"/>
  <arg name="linefit_self_filter_center_y_m" default="0.0"/>
  <arg name="linefit_self_filter_min_z_m" default="-10.0"/>
  <arg name="linefit_self_filter_max_z_m" default="10.0"/>
  <arg name="linefit_enable_pitch_footprint_adjustment" default="true"/>
  <arg name="linefit_pitch_uphill_sign" default="-1.0"/>
  <arg name="linefit_pitch_adjust_deadband_deg" default="2.0"/>
  <arg name="linefit_pitch_adjust_primary_gain_m_per_deg" default="0.02"/>
  <arg name="linefit_pitch_adjust_opposite_gain_m_per_deg" default="0.0"/>
  <arg name="linefit_pitch_adjust_max_extension_m" default="0.25"/>
  <arg name="linefit_enable_slope_residual_filter" default="true"/>
  <arg name="linefit_slope_residual_use_imu_gate" default="true"/>
  <arg name="linefit_slope_residual_enter_pitch_deg" default="4.5"/>
  <arg name="linefit_slope_residual_exit_pitch_deg" default="3.0"/>
  <arg name="linefit_slope_residual_max_range_m" default="3.0"/>
  <arg name="linefit_slope_residual_cell_size_m" default="0.18"/>
  <arg name="linefit_slope_residual_min_z_span_m" default="0.14"/>
  <arg name="linefit_slope_residual_min_points_per_cell" default="2"/>
  <arg name="linefit_slope_residual_remove_sparse_cells" default="true"/>
  <arg name="linefit_slope_residual_keep_front_close_m" default="0.35"/>
  <arg name="planning_obstacle_pointcloud_topic" default="$(eval arg('linefit_selector_non_ground_cloud_topic') if str(arg('enable_linefit_ground_filter_for_planning')).lower() == 'true' else arg('pointcloud_topic'))"/>
  <arg name="robot_base_frame" default="base_link"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="teb_publish_astar_via_points" default="true"/>
  <arg name="teb_use_pointcloud_obstacles" default="true"/>
  <arg name="teb_enable_emergency_stop" default="true"/>
  <arg name="teb_enable_obstacle_slowdown" default="false"/>
  <arg name="teb_enable_local_path_hold_stop" default="true"/>
  <arg name="teb_allow_in_place_rotation_near_obstacle" default="true"/>
  <arg name="teb_allow_in_place_rotation_during_local_hold" default="true"/>
  <arg name="teb_max_angular_slew_rps2" default="0.95"/>
  <arg name="teb_defer_local_hold_while_avoidance_active" default="true"/>
  <arg name="teb_min_in_place_rotation_angular_speed" default="0.05"/>
  <arg name="teb_reverse_replacement_speed_mps" default="0.03"/>
  <arg name="teb_enable_tiny_reverse_forward_crawl" default="true"/>
  <arg name="teb_tiny_reverse_forward_crawl_speed_mps" default="0.04"/>
  <arg name="teb_tiny_reverse_forward_crawl_clearance_m" default="0.80"/>
  <arg name="teb_tiny_reverse_forward_crawl_max_angular_speed" default="0.35"/>
  <arg name="teb_disable_near_goal_forward_crawl" default="false"/>
  <arg name="teb_obstacle_cloud_timeout_s" default="0.6"/>
  <arg name="teb_enable_blind_zone_turn_guard" default="true"/>
  <arg name="teb_blind_zone_turn_guard_radius_m" default="1.20"/>
  <arg name="teb_blind_zone_turn_guard_ttl_s" default="0.45"/>
  <arg name="teb_blind_zone_turn_guard_front_margin_m" default="0.15"/>
  <arg name="teb_blind_zone_turn_guard_support_radius_m" default="0.18"/>
  <arg name="teb_blind_zone_turn_guard_min_points" default="2"/>
  <arg name="teb_blind_zone_front_hold_min_points" default="3"/>
  <arg name="teb_blind_zone_turn_guard_linear_cap_mps" default="0.12"/>
  <arg name="teb_blind_zone_turn_recovery_stop_s" default="0.35"/>
  <arg name="teb_behavior_cmd_timeout_s" default="0.8"/>
  <arg name="teb_rear_approach_conservative_enabled" default="true"/>
  <arg name="teb_rear_approach_max_angular_speed" default="0.12"/>
  <arg name="teb_rear_approach_spin_linear_threshold_mps" default="0.05"/>
  <arg name="teb_rear_approach_no_reverse" default="true"/>
  <arg name="teb_local_hold_timeout_s" default="1.0"/>
  <arg name="teb_publish_final_goal_only" default="true"/>
  <arg name="teb_move_base_goal_lookahead_m" default="1.5"/>
  <arg name="teb_move_base_goal_update_min_dist_m" default="0.50"/>
  <arg name="teb_local_goal_tail_backoff_m" default="0.45"/>
  <arg name="teb_local_goal_tail_backoff_trigger_m" default="1.10"/>
  <arg name="teb_emergency_stop_front_margin" default="0.40"/>
  <arg name="teb_emergency_stop_side_margin" default="0.05"/>
  <arg name="teb_emergency_stop_far_lateral_ratio" default="0.55"/>
  <arg name="teb_slowdown_front_margin" default="0.95"/>
  <arg name="teb_slowdown_side_margin" default="0.08"/>
  <arg name="teb_slowdown_far_lateral_ratio" default="0.75"/>
  <arg name="teb_move_base_goal_topic" default="/planning/teb_goal"/>
  <arg name="teb_filter_max_range_m" default="$(eval '20.0' if str(arg('real_mode')).lower() == 'true' else '10.0')"/>
  <arg name="teb_filter_lateral_limit_y_m" default="3.5"/>
  <arg name="teb_filter_self_margin_m" default="0.11"/>
  <arg name="teb_filter_self_padding_m" default="0.03"/>
  <arg name="teb_local_costmap_width_m" default="12.0"/>
  <arg name="teb_local_costmap_height_m" default="12.0"/>
  <arg name="teb_local_obstacle_range_m" default="8.0"/>
  <arg name="teb_local_raytrace_range_m" default="8.5"/>
  <arg name="teb_local_observation_persistence_s" default="0.40"/>
  <arg name="teb_local_inflation_radius_m" default="0.24"/>
  <arg name="teb_global_inflation_radius_m" default="0.06"/>
  <arg name="teb_min_obstacle_dist_m" default="0.14"/>
  <arg name="teb_inflation_dist_m" default="0.24"/>
  <arg name="teb_weight_viapoint" default="60.0"/>
  <arg name="teb_max_vel_x_backwards_mps" default="0.05"/>
  <arg name="teb_max_vel_theta_rps" default="0.35"/>
  <arg name="teb_acc_lim_theta_rps2" default="0.60"/>
  <arg name="teb_weight_forward_drive" default="8000.0"/>
  <arg name="debug_stop_logging" default="true"/>
  <arg name="debug_dwa_stats" default="true"/>
  <arg name="stop_log_period_s" default="1.0"/>
  <arg name="use_pointcloud_obstacle_cost" default="false"/>
  <arg name="obstacle_collision_radius" default="0.0"/>
  <arg name="robot_width_m" default="0.58"/>
  <arg name="robot_length_m" default="0.612"/>
  <arg name="footprint_padding_m" default="0.05"/>
  <arg name="path_blocking_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.16)"/>
  <arg name="near_goal_relaxed_path_blocking_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.02)"/>
  <arg name="grid_only_relaxed_path_blocking_enabled" default="true"/>
  <arg name="grid_only_relaxed_path_blocking_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.02)"/>
  <arg name="global_path_grid_planner" default="astar8"/>
  <arg name="global_path_candidate_count" default="7"/>
  <arg name="global_path_candidate_fanout_enabled" default="true"/>
  <arg name="global_path_candidate_fanout_anchor_count" default="2"/>
  <arg name="global_path_candidate_fanout_levels" default="2"/>
  <arg name="global_path_candidate_fanout_lateral_step_m" default="0.90"/>
  <arg name="global_path_candidate_fanout_snap_radius_cells" default="8"/>
  <arg name="global_path_use_any_angle" default="true"/>
  <arg name="global_path_clearance_m" default="$(eval '0.00' if str(arg('real_mode')).lower() == 'true' else '0.02')"/>
  <arg name="global_path_clearance_model" default="$(eval 'width' if str(arg('real_mode')).lower() == 'true' else 'circumscribed')"/>
  <arg name="global_path_drivable_area_is_center_safe" default="$(eval 'true' if str(arg('real_mode')).lower() == 'true' else 'false')"/>
  <arg name="global_path_goal_tail_clearance_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.02)"/>
  <arg name="drivable_grid_graph_fallback_max_goal_gap_m" default="1.0"/>
  <arg name="global_path_enable_graph_fallback" default="false"/>
  <arg name="drivable_grid_goal_extension_max_gap_m" default="0.60"/>
  <arg name="preserve_user_goal_on_drivable_grid" default="true"/>
  <arg name="global_path_continuous_replan" default="true"/>
  <arg name="global_path_replan_min_start_shift_m" default="0.30"/>
  <arg name="global_path_replan_min_interval_s" default="0.35"/>
  <arg name="global_path_replan_validation_lookahead_m" default="22.0"/>
  <arg name="global_path_replan_start_ignore_m" default="0.35"/>
  <arg name="global_path_replan_start_deviation_m" default="0.60"/>
  <arg name="global_path_planner_loop_hz" default="8.0"/>
  <arg name="global_path_republish_period_s" default="0.50"/>
  <arg name="grid_snap_search_radius_cells" default="$(eval '60' if str(arg('real_mode')).lower() == 'true' else '30')"/>
  <arg name="candidate_route_switching_enabled" default="true"/>
  <arg name="candidate_route_switch_lookahead_m" default="20.0"/>
  <arg name="candidate_route_switch_start_ignore_m" default="0.35"/>
  <arg name="candidate_route_switch_corridor_radius_m" default="$(eval 0.5 * float(arg('robot_width_m')) + float(arg('footprint_padding_m')) + 0.05)"/>
  <arg name="candidate_route_switch_blocked_score_threshold" default="$(eval '5.0' if str(arg('real_mode')).lower() == 'true' else '4.0')"/>
  <arg name="candidate_route_switch_score_margin" default="$(eval '6.0' if str(arg('real_mode')).lower() == 'true' else '4.0')"/>
  <arg name="candidate_route_switch_min_hold_s" default="$(eval '3.0' if str(arg('real_mode')).lower() == 'true' else '1.0')"/>
  <arg name="candidate_route_switch_confirm_count" default="$(eval '3' if str(arg('real_mode')).lower() == 'true' else '2')"/>
  <arg name="candidate_route_switch_require_centerline_blocked" default="true"/>
  <arg name="candidate_route_switch_centerline_clearance_m" default="$(eval '0.10' if str(arg('real_mode')).lower() == 'true' else '0.00')"/>
  <arg name="candidate_route_switch_require_best_clear" default="true"/>
  <arg name="candidate_route_switch_best_clear_score_threshold" default="$(arg candidate_route_switch_blocked_score_threshold)"/>
  <arg name="candidate_route_replan_match_distance_m" default="0.60"/>
  <arg name="path_tracking_only" default="true"/>
  <arg name="path_tracking_speed_cap" default="$(eval '0.60' if str(arg('real_mode')).lower() == 'true' else '0.25')"/>
  <arg name="path_tracking_steer_filter_gain" default="0.25"/>
  <arg name="lookahead_distance" default="$(eval '0.85' if str(arg('real_mode')).lower() == 'true' else '1.15')"/>
  <arg name="snap_lat_err" default="0.20"/>
  <arg name="snap_target_ahead_m" default="0.60"/>
  <arg name="tracking_projection_back_window_m" default="0.35"/>
  <arg name="tracking_projection_forward_window_m" default="$(eval '1.35' if str(arg('real_mode')).lower() == 'true' else '1.50')"/>
  <arg name="tracking_path_smoothing_passes" default="$(eval '1' if str(arg('real_mode')).lower() == 'true' else '3')"/>
  <arg name="path_tracking_yaw_rate_max_deg" default="$(eval '38.0' if str(arg('real_mode')).lower() == 'true' else '42.0')"/>
  <arg name="path_tracking_in_place_yaw_rate_max_deg" default="$(eval '26.0' if str(arg('real_mode')).lower() == 'true' else '30.0')"/>
  <arg name="path_tracking_yaw_accel_max_deg" default="120.0"/>
  <arg name="path_tracking_slowdown_yaw_deg" default="$(eval '55.0' if str(arg('real_mode')).lower() == 'true' else '40.0')"/>
  <arg name="path_tracking_stop_yaw_deg" default="$(eval '120.0' if str(arg('real_mode')).lower() == 'true' else '85.0')"/>
  <arg name="path_tracking_cte_gain" default="$(eval '0.65' if str(arg('real_mode')).lower() == 'true' else '0.80')"/>
  <arg name="path_tracking_cte_soft_mps" default="0.25"/>
  <arg name="path_tracking_cte_deadband_m" default="0.05"/>
  <arg name="path_tracking_cte_filter_gain" default="$(eval '0.20' if str(arg('real_mode')).lower() == 'true' else '0.18')"/>
  <arg name="path_tracking_cte_yaw_cap_deg" default="25.0"/>
  <arg name="path_tracking_heading_filter_gain" default="$(eval '0.10' if str(arg('real_mode')).lower() == 'true' else '0.12')"/>
  <arg name="path_tracking_goal_bearing_gain" default="$(eval '0.65' if str(arg('real_mode')).lower() == 'true' else '0.45')"/>
  <arg name="path_tracking_goal_bearing_cap_deg" default="35.0"/>
  <arg name="path_tracking_target_step_m" default="$(eval '0.28' if str(arg('real_mode')).lower() == 'true' else '0.18')"/>
  <arg name="path_tracking_tangent_window_m" default="$(eval '0.80' if str(arg('real_mode')).lower() == 'true' else '0.60')"/>
  <arg name="path_tracking_crawl_speed" default="$(eval '0.22' if str(arg('real_mode')).lower() == 'true' else '0.10')"/>
  <arg name="path_tracking_large_yaw_crawl_speed" default="$(eval '0.18' if str(arg('real_mode')).lower() == 'true' else '0.07')"/>
  <arg name="final_approach_window_m" default="$(eval '1.5' if str(arg('real_mode')).lower() == 'true' else '2.5')"/>
  <arg name="final_speed_k" default="$(eval '0.95' if str(arg('real_mode')).lower() == 'true' else '0.75')"/>
  <arg name="final_speed_min" default="$(eval '0.34' if str(arg('real_mode')).lower() == 'true' else '0.22')"/>
  <arg name="path_tracking_stop_distance_m" default="$(eval '0.35' if str(arg('real_mode')).lower() == 'true' else '0.80')"/>
  <arg name="path_tracking_goal_yaw_rate_max_deg" default="$(eval '18.0' if str(arg('real_mode')).lower() == 'true' else '25.0')"/>
  <arg name="path_tracking_drivable_ignore_start_distance_m" default="$(eval '0.90' if str(arg('real_mode')).lower() == 'true' else '0.45')"/>
  <arg name="path_tracking_recovery_ignore_start_distance_m" default="$(eval '1.80' if str(arg('real_mode')).lower() == 'true' else '0.90')"/>
  <arg name="forward_motion_deadband" default="0.01"/>
  <arg name="min_forward_cmd" default="$(eval '0.15' if str(arg('real_mode')).lower() == 'true' else '0.12')"/>
  <arg name="min_forward_cmd_distance" default="$(eval '0.25' if str(arg('real_mode')).lower() == 'true' else '0.60')"/>
  <arg name="cruise_min_speed" default="$(eval '0.26' if str(arg('real_mode')).lower() == 'true' else '0.0')"/>
  <arg name="cruise_distance_m" default="$(eval '1.80' if str(arg('real_mode')).lower() == 'true' else '2.50')"/>
  <arg name="rotate_only_deg" default="$(eval '150.0' if str(arg('real_mode')).lower() == 'true' else '110.0')"/>
  <arg name="rotate_exit_deg" default="40.0"/>
  <arg name="rotate_reentry_cooldown_s" default="4.0"/>
  <arg name="near_goal_no_rotate_m" default="1.5"/>
