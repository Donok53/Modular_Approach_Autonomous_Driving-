  <group if="$(arg enable_explainability_bridge)">
    <include file="$(find autonomy_explainability_bridge)/launch/explainability_bridge.launch">
      <arg name="publish_hz" value="$(arg explainability_publish_hz)"/>
      <arg name="manifest_publish_period_s" value="$(arg explainability_manifest_publish_period_s)"/>
      <arg name="stale_after_s" value="$(arg explainability_stale_after_s)"/>
      <arg name="overlay_threshold" value="$(arg global_obstacle_overlay_threshold)"/>

      <arg name="pose_topic" value="$(arg pose_topic)"/>
      <arg name="raw_lidar_topic" value="$(arg pointcloud_topic)"/>
      <arg name="watch_raw_lidar" value="$(arg explainability_watch_raw_lidar)"/>
      <arg name="obstacle_pointcloud_topic" value="$(arg planning_obstacle_pointcloud_topic)"/>
      <arg name="watch_obstacle_pointcloud" value="$(arg explainability_watch_obstacle_pointcloud)"/>

      <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
      <arg name="behavior_cmd_topic" value="$(arg behavior_cmd_topic)"/>
      <arg name="emergency_stop_topic" value="$(arg emergency_stop_topic)"/>
      <arg name="global_obstacle_caution_topic" value="$(arg global_obstacle_caution_topic)"/>
      <arg name="path_blocked_topic" value="$(arg path_blocked_topic)"/>

      <arg name="global_path_topic" value="/astar/path"/>
      <arg name="candidate_paths_topic" value="/astar/candidate_paths"/>
      <arg name="tracking_reference_topic" value="$(arg tracking_reference_topic)"/>
      <arg name="path_mode_topic" value="$(arg path_mode_topic)"/>
      <arg name="active_path_topic" value="$(arg active_path_topic)"/>
      <arg name="local_path_topic" value="$(arg local_path_topic)"/>
