      <arg name="global_obstacle_overlay_topic" value="$(arg global_obstacle_overlay_topic)"/>
      <arg name="global_obstacle_overlay_boxes_topic" value="$(arg global_obstacle_overlay_boxes_topic)"/>
      <arg name="near_field_raw_overlay_hits_topic" value="$(arg near_field_raw_overlay_hit_cloud_topic)"/>
      <arg name="near_field_stop_hits_topic" value="$(arg near_field_raw_stop_hit_cloud_topic)"/>
      <arg name="near_field_raw_debug_cloud_topic" value="$(arg near_field_raw_debug_cloud_topic)"/>
      <arg name="near_field_stop_marker_topic" value="$(arg near_field_raw_stop_marker_topic)"/>
      <arg name="drivable_grid_topic" value="$(arg drivable_grid_topic)"/>
      <arg name="tracked_objects_topic" value="$(arg tracked_objects_topic)"/>

      <arg name="topic_manifest_topic" value="$(arg xai_topic_manifest_topic)"/>
      <arg name="planner_snapshot_topic" value="$(arg xai_planner_snapshot_topic)"/>
      <arg name="event_log_topic" value="$(arg xai_event_log_topic)"/>
    </include>
  </group>

  <!-- C++ local replanner. Active iff use_cpp_replanner=true (default
       true for outdoor). The Python constrained_local_replanner is
       skipped in this case via the use_cpp_replanner flag forwarded
       into dynamic_window_approach.launch / teb_trial.launch. -->
  <group if="$(arg use_cpp_replanner)">
    <include file="$(find constrained_local_replanner_cpp)/launch/replanner_cpp.launch">
      <arg name="primary_mode" value="true"/>
      <arg name="cloud_topic" value="$(arg planning_obstacle_pointcloud_topic)"/>
      <arg name="cloud_z_min_m" value="$(arg cpp_replanner_cloud_z_min_m)"/>
      <arg name="cloud_world_z_min_m" value="$(arg cpp_replanner_cloud_world_z_min_m)"/>
      <arg name="drivable_grid_topic" value="$(arg drivable_grid_topic)"/>
      <arg name="odom_topic" value="lio_localizer/odometry/optimization"/>
      <arg name="global_path_topic" value="/astar/path"/>
      <arg name="lookahead_m" value="$(arg avoidance_trigger_ahead_m)"/>
      <arg name="avoidance_trigger_ahead_m" value="$(arg avoidance_trigger_ahead_m)"/>
      <arg name="obstacle_block_margin_m" value="$(arg obstacle_block_margin_m)"/>
      <arg name="sidestep_min_offset_m" value="$(arg sidestep_avoidance_min_offset_m)"/>
      <arg name="sidestep_max_offset_m" value="$(arg sidestep_avoidance_max_offset_m)"/>
      <arg name="sidestep_preview_m" value="$(arg sidestep_avoidance_preview_m)"/>
      <arg name="sidestep_clearance_extra_m" value="$(arg sidestep_avoidance_clearance_extra_m)"/>
      <arg name="sidestep_entry_lead_m" value="$(arg sidestep_avoidance_entry_lead_m)"/>
      <arg name="rejoin_min_distance_m" value="$(arg avoidance_rejoin_min_distance_m)"/>
      <arg name="grid_unknown_is_occupied" value="$(arg grid_unknown_is_occupied)"/>
      <arg name="branch_max_expand" value="$(arg max_expand)"/>
      <arg name="branch_time_budget_s" value="$(arg avoidance_branch_time_budget_s)"/>
      <arg name="branch_max_rejoin_candidates" value="$(arg avoidance_branch_max_rejoin_candidates)"/>
      <arg name="return_to_global_trigger_distance_m" value="$(arg return_to_global_trigger_distance_m)"/>
      <arg name="return_to_global_min_tail_m" value="$(arg return_to_global_min_tail_m)"/>
      <arg name="return_to_global_goal_tolerance_m" value="$(arg return_to_global_goal_tolerance_m)"/>
      <arg name="return_to_global_max_candidates" value="$(arg return_to_global_max_candidates)"/>
      <arg name="candidate_start_clearance_m" value="$(arg candidate_start_clearance_m)"/>
      <arg name="clear_detour_hold_s" value="$(arg avoidance_clear_detour_hold_s)"/>
      <arg name="keep_until_endpoint_distance_m" value="$(arg avoidance_keep_until_endpoint_distance_m)"/>
      <arg name="locked_static_ttl_s" value="$(arg locked_static_ttl_s)"/>
      <arg name="hold_escape_timeout_s" value="$(arg hold_escape_timeout_s)"/>
      <arg name="hold_without_candidate" value="$(arg hold_without_candidate)"/>
    </include>
  </group>

</launch>
