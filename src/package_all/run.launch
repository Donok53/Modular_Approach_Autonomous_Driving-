      <arg name="blind_zone_turn_guard_radius_m" value="$(arg teb_blind_zone_turn_guard_radius_m)"/>
      <arg name="blind_zone_turn_guard_ttl_s" value="$(arg teb_blind_zone_turn_guard_ttl_s)"/>
      <arg name="blind_zone_turn_guard_front_margin_m" value="$(arg teb_blind_zone_turn_guard_front_margin_m)"/>
