  <arg name="static_obstacle_memory_blind_zone_radius_m" default="1.40"/>
  <arg name="static_obstacle_memory_blind_zone_hold_ttl_s" default="5.0"/>
  <arg name="known_map_subtraction_enabled" default="false"/>
