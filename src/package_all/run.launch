<launch>
  <arg name="use_sim_time" default="false"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>
  <arg name="real_mode" default="false"/>
  <arg name="localization_environment" default="outdoor"/>
  <arg name="outdoor_use_saved_map_assets" default="true"/>
  <arg name="use_lio_sam" default="$(eval 'true' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'false')"/>
  <arg name="map_profile_name" default="$(eval 'outdoor' if str(arg('real_mode')).lower() == 'outdoor' else ('real' if str(arg('real_mode')).lower() == 'true' else 'test'))"/>
  <arg name="map_profile_suffix" default="$(eval '_outdoor' if str(arg('real_mode')).lower() == 'outdoor' else ('_real' if str(arg('real_mode')).lower() == 'true' else ''))"/>
  <arg name="localizer_map_relative_path" default="$(eval '/map/outdoor' if str(arg('real_mode')).lower() == 'outdoor' else ('/map/real' if str(arg('real_mode')).lower() == 'true' else '/map/test'))"/>
  <arg name="localizer_map_bundle_dir" default="$(find lio_localizer)/map/$(arg map_profile_name)"/>
  <arg name="runtime_drivable_state_file" default="$(env HOME)/.ros/lio_sam_drivable_area_state$(arg map_profile_suffix).json"/>
  <arg name="launch_profile_label" default="$(arg map_profile_name)"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="enable_localizer_drivable_area" default="$(eval 'false' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'true')"/>
  <arg name="enable_localizer_drivable_area_2d_editor" default="false"/>
  <arg name="enable_lio_sam_drivable_area_2d_editor" default="false"/>
  <arg name="enable_localizer_global_map_2d_background" default="$(eval 'false' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'true')"/>
  <arg name="enable_localizer_global_map_2d_edit_plane" default="$(eval 'false' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'true')"/>
  <arg name="localizer_global_map_2d_reload_period_s" default="2.0"/>
  <arg name="localizer_use_internal_initial_pose" default="false"/>
  <arg name="localizer_initial_pose_x_m" default="0.0"/>
  <arg name="localizer_initial_pose_y_m" default="0.0"/>
  <arg name="localizer_initial_pose_z_m" default="0.0"/>
  <arg name="localizer_initial_pose_roll_deg" default="0.0"/>
  <arg name="localizer_initial_pose_pitch_deg" default="0.0"/>
  <arg name="localizer_initial_pose_yaw_deg" default="160.6"/>
  <arg name="pose_topic" default="$(eval '/lio_sam/mapping/odometry' if arg('use_lio_sam') == 'true' else 'lio_localizer/odometry/optimization')"/>
  <arg name="planning_pose_topic" default="/lio_localizer/odometry/planning"/>
  <arg name="controller_pose_topic" default="$(arg planning_pose_topic)"/>
  <arg name="enable_pose_filter" default="true"/>
  <arg name="pose_filter_twist_topic" default="$(eval '/lio_sam/mapping/odometry_incremental' if arg('use_lio_sam') == 'true' else '/lio_localizer/odometry/lidar_incremental')"/>
  <arg name="pose_filter_twist_linear_frame" default="world"/>
  <arg name="pose_filter_twist_timeout_s" default="0.30"/>
  <arg name="pose_filter_use_incremental_pose_prediction" default="true"/>
  <arg name="pose_filter_incremental_pose_timeout_s" default="0.20"/>
  <arg name="pose_filter_output_child_frame_id" default="base_link"/>
  <arg name="pose_filter_forward_tau_s" default="0.05"/>
  <arg name="pose_filter_lateral_tau_s" default="0.10"/>
  <arg name="pose_filter_turning_lateral_tau_s" default="0.05"/>
  <arg name="pose_filter_yaw_tau_s" default="0.12"/>
  <arg name="pose_filter_turning_yaw_tau_s" default="0.06"/>
  <arg name="pose_filter_twist_tau_s" default="0.08"/>
  <arg name="pose_filter_predict_to_now" default="true"/>
  <arg name="pose_filter_max_predict_age_s" default="0.25"/>
  <arg name="pose_filter_publish_now_stamp" default="true"/>
  <arg name="pose_filter_publish_hz" default="25.0"/>
  <arg name="pose_filter_debug_latency_logging" default="true"/>
  <arg name="pose_filter_debug_latency_log_period_s" default="1.0"/>
  <arg name="pose_filter_lateral_deadband_m" default="0.04"/>
  <arg name="pose_filter_yaw_deadband_deg" default="2.0"/>
  <arg name="pose_filter_straight_speed_min_mps" default="0.12"/>
  <arg name="pose_filter_turning_yaw_rate_threshold_rps" default="0.28"/>
  <arg name="pose_filter_turning_yaw_error_deg" default="12.0"/>
  <arg name="pose_filter_max_straight_lateral_correction_mps" default="0.12"/>
  <arg name="pointcloud_topic" default="/ouster/points"/>
  <arg name="imu_topic" default="/imu/data"/>
  <arg name="cloud_tracker_pointcloud_topic" default="$(eval '/lio_sam/deskew/cloud_deskewed' if arg('use_lio_sam') == 'true' else '/lio_localizer/localization/cloud_deskewed')"/>
  <arg name="use_drivable_grid" default="true"/>
  <arg name="drivable_grid_topic" default="/lio_sam/drivable_area/grid"/>
  <arg name="grid_unknown_is_occupied" default="true"/>
  <arg name="enable_cloud_tracker" default="false"/>
  <arg name="enable_dynamic_risk_manager" default="false"/>
  <arg name="enable_local_replanner" default="true"/>
  <!-- C++ replanner owns the local-planning outputs by default for both indoor
       and outdoor runs:
       /planning/local_path, /planning/path_mode, /planning/avoidance_path,
       /planning/recognized_obstacles, /planning/blocking_obstacles,
       /planning/global_obstacle_overlay, /planning/path_history,
       /planning/travel_history(_path), /planning/local_replanner_debug_text.
       Map/profile selection above is still controlled by localization_environment
       / real_mode, so indoor launches keep the indoor map path while using the
       low-latency C++ replanner.
       Fall back with use_cpp_replanner:=false. -->
  <arg name="use_cpp_replanner" default="true"/>
  <arg name="follow_global_path_only" default="$(eval 'false' if str(arg('use_cpp_replanner')).lower() == 'true' or str(arg('enable_local_replanner')).lower() == 'true' else 'true')"/>
  <arg name="use_dynamic_risk_grid" default="false"/>
  <arg name="tracked_objects_topic" default="/perception/tracked_objects"/>
  <arg name="enable_tracked_objects_marker_viz" default="false"/>
  <arg name="behavior_cmd_topic" default="/planning/behavior_cmd"/>
  <arg name="path_blocked_topic" default="/astar/path_blocked"/>
  <arg name="emergency_stop_topic" default="/planning/emergency_stop"/>
  <arg name="local_path_topic" default="/planning/local_path"/>
  <arg name="local_path_timeout_s" default="$(eval '1.20' if str(arg('localization_environment')).lower() == 'outdoor' else '4.00')"/>
  <arg name="local_path_source_timeout_s" default="$(arg local_path_timeout_s)"/>
  <arg name="local_path_signature_start_resolution_m" default="0.10"/>
  <arg name="local_path_keepalive_enabled" default="true"/>
  <arg name="local_path_keepalive_hz" default="5.0"/>
  <arg name="local_path_keepalive_max_age_s" default="$(eval '2.50' if str(arg('localization_environment')).lower() == 'outdoor' else '4.00')"/>
  <arg name="avoidance_path_topic" default="/planning/avoidance_path"/>
  <arg name="path_mode_topic" default="/planning/path_mode"/>
  <arg name="freeze_global_replan_during_local_mode" default="true"/>
  <arg name="freeze_global_path_after_first_plan" default="true"/>
  <arg name="nominal_path_reference_mode" default="local"/>
  <arg name="nominal_start_heading_penalty_m" default="$(eval '1.50' if str(arg('localization_environment')).lower() == 'outdoor' else '1.00')"/>
  <arg name="nominal_start_heading_search_ahead_m" default="$(eval '5.0' if str(arg('localization_environment')).lower() == 'outdoor' else '3.0')"/>
  <arg name="nominal_start_min_heading_dot" default="$(eval '0.18' if str(arg('localization_environment')).lower() == 'outdoor' else '0.05')"/>
  <arg name="nominal_start_backtrack_m" default="$(eval '1.20' if str(arg('localization_environment')).lower() == 'outdoor' else '0.60')"/>
  <arg name="active_path_topic" default="/planning/active_path"/>
  <arg name="active_path_viz_topic" default="/planning/active_path_viz"/>
  <arg name="tracking_reference_topic" default="/planning/tracking_reference_path"/>
  <arg name="use_local_path_fallback" default="$(eval 'true' if str(arg('localization_environment')).lower() == 'outdoor' else 'false')"/>
  <arg name="path_history_topic" default="/planning/path_history"/>
  <arg name="travel_history_topic" default=""/>
  <arg name="travel_history_path_topic" default=""/>
  <arg name="localization_history_topic" default=""/>
  <arg name="localization_history_path_topic" default=""/>
  <arg name="current_robot_pose_marker_topic" default="/planning/current_robot_pose_marker"/>
  <arg name="dynamic_risk_grid_topic" default="/planning/dynamic_risk_grid"/>
  <arg name="enable_explainability_bridge" default="true"/>
  <arg name="explainability_publish_hz" default="5.0"/>
  <arg name="explainability_manifest_publish_period_s" default="10.0"/>
  <arg name="explainability_stale_after_s" default="1.5"/>
  <arg name="explainability_watch_raw_lidar" default="false"/>
  <arg name="explainability_watch_obstacle_pointcloud" default="false"/>
  <arg name="xai_topic_manifest_topic" default="/xai/topic_manifest"/>
  <arg name="xai_planner_snapshot_topic" default="/xai/planner_snapshot"/>
  <arg name="xai_event_log_topic" default="/xai/event_log"/>
  <arg name="use_free_area_goal" default="false"/>
  <arg name="free_area_goal_topic" default="/move_base_simple/goal"/>
  <arg name="enable_crossing_portal_manager" default="false"/>
  <arg name="crossing_portal_config_file" default="$(find dynamic_window_approach)/config/crossing_portals.yaml"/>
  <arg name="crossing_portal_odom_topic" default="$(arg pose_topic)"/>
  <arg name="crossing_portal_goal_topic" default="/planning/crossing_direct_goal"/>
  <arg name="crossing_portal_status_topic" default="/planning/crossing_portal_status"/>
  <arg name="crossing_portal_publish_hz" default="5.0"/>
  <arg name="crossing_portal_direct_goal_timeout_s" default="1.0"/>
  <arg name="crossing_portal_direct_goal_refresh_distance_m" default="0.35"/>
  <arg name="crossing_portal_direct_goal_refresh_yaw_deg" default="14.0"/>
  <arg name="freeze_path_on_first_plan" default="true"/>
  <arg name="smooth_path_line_of_sight" default="true"/>
  <arg name="smooth_avoidance_line_of_sight" default="true"/>
  <arg name="max_los_segment_m" default="4.0"/>
  <arg name="published_path_spacing_m" default="0.25"/>
  <arg name="path_history_max_paths" default="12"/>
  <arg name="local_replan_hz" default="3.0"/>
  <arg name="local_replan_lookahead_m" default="$(eval '9.0' if str(arg('localization_environment')).lower() == 'outdoor' else '7.0')"/>
  <arg name="allow_best_effort_local_path" default="true"/>
  <arg name="best_effort_max_goal_gap_m" default="0.90"/>
  <arg name="enable_avoidance_path" default="$(arg enable_local_replanner)"/>
  <arg name="enable_graph_planner" default="$(eval 'false' if str(arg('localization_environment')).lower() == 'outdoor' and str(arg('outdoor_use_saved_map_assets')).lower() != 'true' else 'true')"/>
  <arg name="enable_robot_send" default="false"/>
  <arg name="enable_wave_cmd_bridge" default="false"/>
  <arg name="wave_port_name" default=""/>
  <arg name="wave_baud_rate" default="19200"/>
  <arg name="wave_linear_scale" default="1.0"/>
  <arg name="wave_angular_scale" default="1.0"/>
  <arg name="wave_emergency_preserve_angular" default="true"/>
  <arg name="wave_emergency_angular_limit_rps" default="0.35"/>
  <arg name="local_planner_mode" default="custom"/>
  <arg name="enable_linefit_ground_filter_for_planning" default="true"/>
  <arg name="enable_linefit_self_filter" default="true"/>
  <arg name="linefit_pointcloud_topic" default="$(arg cloud_tracker_pointcloud_topic)"/>
  <arg name="linefit_raw_frame" default="os_sensor"/>
  <arg name="linefit_gravity_frame" default="os_sensor_gravity"/>
  <arg name="linefit_ground_cloud_topic" default="/planning/linefit_ground/ground_cloud"/>
  <arg name="linefit_raw_non_ground_cloud_topic" default="/planning/linefit_ground/non_ground_cloud_raw"/>
  <arg name="linefit_non_ground_cloud_topic" default="/planning/linefit_ground/non_ground_cloud"/>
  <arg name="linefit_selector_non_ground_cloud_topic" default="$(eval arg('linefit_raw_non_ground_cloud_topic') if str(arg('enable_linefit_self_filter')).lower() == 'true' else arg('linefit_non_ground_cloud_topic'))"/>
  <arg name="enable_planning_self_filter" default="true"/>
  <arg name="linefit_mode_topic" default="/planning/linefit_ground/mode"/>
  <arg name="linefit_sensor_height_m" default="0.525"/>
  <arg name="linefit_r_min_m" default="0.10"/>
  <arg name="linefit_r_max_m" default="25.0"/>
  <arg name="linefit_max_dist_to_line" default="0.08"/>
  <arg name="linefit_max_fit_error" default="0.08"/>
  <arg name="linefit_long_threshold" default="1.5"/>
  <arg name="linefit_line_search_angle" default="0.20"/>
  <arg name="linefit_flat_max_slope" default="0.45"/>
  <arg name="linefit_flat_max_start_height" default="0.32"/>
  <arg name="linefit_flat_max_long_height" default="0.18"/>
  <arg name="linefit_slope_max_slope" default="0.58"/>
  <arg name="linefit_slope_max_start_height" default="0.40"/>
  <arg name="linefit_slope_max_long_height" default="0.24"/>
  <arg name="linefit_enter_slope_pitch_deg" default="4.5"/>
  <arg name="linefit_exit_slope_pitch_deg" default="3.0"/>
  <arg name="linefit_n_threads" default="$(eval '2' if str(arg('localization_environment')).lower() == 'outdoor' else '4')"/>
  <arg name="linefit_self_filter_padding_m" default="0.06"/>
  <arg name="linefit_self_filter_center_x_m" default="0.0"/>
  <arg name="linefit_self_filter_center_y_m" default="0.0"/>
  <arg name="linefit_self_filter_min_z_m" default="-10.0"/>
  <arg name="linefit_self_filter_max_z_m" default="10.0"/>
  <arg name="linefit_enable_pitch_footprint_adjustment" default="true"/>
  <arg name="linefit_pitch_uphill_sign" default="-1.0"/>
  <arg name="linefit_pitch_adjust_deadband_deg" default="2.0"/>
  <arg name="linefit_pitch_adjust_primary_gain_m_per_deg" default="0.02"/>
  <arg name="linefit_pitch_adjust_opposite_gain_m_per_deg" default="0.0"/>
  <arg name="linefit_pitch_adjust_max_extension_m" default="0.25"/>
  <arg name="linefit_enable_slope_residual_filter" default="true"/>
  <arg name="linefit_slope_residual_use_imu_gate" default="true"/>
  <arg name="linefit_slope_residual_enter_pitch_deg" default="4.5"/>
  <arg name="linefit_slope_residual_exit_pitch_deg" default="3.0"/>
  <arg name="linefit_slope_residual_max_range_m" default="3.0"/>
  <arg name="linefit_slope_residual_cell_size_m" default="0.18"/>
  <arg name="linefit_slope_residual_min_z_span_m" default="0.14"/>
  <arg name="linefit_slope_residual_min_points_per_cell" default="2"/>
  <arg name="linefit_slope_residual_remove_sparse_cells" default="true"/>
  <arg name="linefit_slope_residual_keep_front_close_m" default="0.35"/>
  <arg name="planning_use_filtered_non_ground_cloud" default="true"/>
  <arg name="planning_obstacle_pointcloud_topic" default="$(eval arg('pointcloud_topic') if str(arg('enable_linefit_ground_filter_for_planning')).lower() != 'true' else (arg('linefit_non_ground_cloud_topic') if str(arg('planning_use_filtered_non_ground_cloud')).lower() == 'true' else arg('linefit_selector_non_ground_cloud_topic')))"/>
  <arg name="robot_base_frame" default="base_link"/>
  <arg name="publish_os_sensor_static_tf" default="true"/>
  <arg name="os_sensor_frame" default="os_sensor"/>
  <arg name="os_sensor_parent_frame" default="$(arg robot_base_frame)"/>
  <arg name="os_sensor_x_m" default="0.0"/>
  <arg name="os_sensor_y_m" default="0.0"/>
  <arg name="os_sensor_z_m" default="$(arg linefit_sensor_height_m)"/>
  <arg name="near_field_raw_overlay_enabled" default="true"/>
  <arg name="near_field_raw_overlay_topic" default="$(arg pointcloud_topic)"/>
  <arg name="near_field_raw_overlay_base_frame" default="$(arg robot_base_frame)"/>
  <arg name="near_field_raw_overlay_tf_timeout_s" default="0.02"/>
  <arg name="near_field_raw_overlay_tf_fallback_latest" default="true"/>
  <arg name="near_field_raw_overlay_allow_raw_frame_on_tf_failure" default="true"/>
  <arg name="near_field_raw_overlay_min_x_m" default="0.05"/>
  <arg name="near_field_raw_overlay_max_x_m" default="$(eval '2.40' if str(arg('localization_environment')).lower() == 'outdoor' else '1.60')"/>
  <arg name="near_field_raw_overlay_half_width_m" default="0.65"/>
  <arg name="near_field_raw_overlay_min_z_m" default="0.08"/>
  <arg name="near_field_raw_overlay_max_z_m" default="1.40"/>
  <arg name="near_field_raw_overlay_downsample" default="2"/>
  <arg name="near_field_raw_overlay_max_update_hz" default="$(eval '5.0' if str(arg('localization_environment')).lower() == 'outdoor' else '4.0')"/>
  <arg name="near_field_raw_overlay_uv_row_step" default="$(eval '4' if str(arg('localization_environment')).lower() == 'outdoor' else '2')"/>
  <arg name="near_field_raw_overlay_uv_col_step" default="$(eval '8' if str(arg('localization_environment')).lower() == 'outdoor' else '4')"/>
  <arg name="near_field_raw_overlay_min_points" default="3"/>
  <arg name="near_field_raw_overlay_min_cells" default="1"/>
  <arg name="near_field_raw_overlay_min_points_per_cell" default="2"/>
  <arg name="near_field_raw_overlay_min_z_span_m" default="0.12"/>
  <arg name="near_field_raw_overlay_ttl_s" default="0.60"/>
  <arg name="near_field_raw_overlay_hit_cloud_topic" default="/planning/near_field_raw_overlay_hits"/>
  <arg name="use_raw_near_obstacle_hits" default="$(arg near_field_raw_overlay_enabled)"/>
  <arg name="raw_near_obstacle_hits_topic" default="$(arg near_field_raw_overlay_hit_cloud_topic)"/>
  <arg name="raw_near_obstacle_hold_s" default="0.25"/>
  <arg name="near_field_raw_debug_cloud_enabled" default="true"/>
  <arg name="near_field_raw_debug_cloud_topic" default="/planning/near_field_raw_debug_cloud"/>
  <arg name="near_field_raw_debug_min_x_m" default="-1.2"/>
  <arg name="near_field_raw_debug_max_x_m" default="1.8"/>
  <arg name="near_field_raw_debug_half_width_m" default="1.2"/>
  <arg name="near_field_raw_debug_min_z_m" default="-0.35"/>
  <arg name="near_field_raw_debug_max_z_m" default="1.50"/>
  <arg name="near_field_raw_debug_publish_hz" default="1.0"/>
  <arg name="near_field_raw_debug_max_points" default="$(eval '400' if str(arg('localization_environment')).lower() == 'outdoor' else '1200')"/>
  <arg name="near_field_raw_overlay_log_period_s" default="2.0"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="teb_publish_astar_via_points" default="true"/>
  <arg name="teb_use_pointcloud_obstacles" default="true"/>
  <arg name="teb_enable_emergency_stop" default="true"/>
  <arg name="teb_enable_obstacle_slowdown" default="false"/>
  <arg name="teb_enable_local_path_hold_stop" default="true"/>
  <arg name="teb_allow_in_place_rotation_near_obstacle" default="true"/>
  <arg name="teb_allow_in_place_rotation_during_local_hold" default="true"/>
  <arg name="teb_max_angular_slew_rps2" default="1.25"/>
  <arg name="teb_defer_local_hold_while_avoidance_active" default="true"/>
  <arg name="teb_min_in_place_rotation_angular_speed" default="0.05"/>
  <arg name="teb_reverse_replacement_speed_mps" default="0.03"/>
  <arg name="teb_enable_tiny_reverse_forward_crawl" default="true"/>
  <arg name="teb_tiny_reverse_forward_crawl_speed_mps" default="0.04"/>
  <arg name="teb_tiny_reverse_forward_crawl_clearance_m" default="0.80"/>
  <arg name="teb_tiny_reverse_forward_crawl_max_angular_speed" default="0.35"/>
  <arg name="teb_disable_near_goal_forward_crawl" default="false"/>
  <arg name="teb_obstacle_cloud_timeout_s" default="0.6"/>
  <arg name="teb_enable_blind_zone_turn_guard" default="true"/>
  <arg name="teb_blind_zone_turn_guard_radius_m" default="1.20"/>
  <arg name="teb_blind_zone_turn_guard_ttl_s" default="0.45"/>
  <arg name="teb_blind_zone_turn_guard_front_margin_m" default="0.15"/>
  <arg name="teb_blind_zone_turn_guard_support_radius_m" default="0.18"/>
  <arg name="teb_blind_zone_turn_guard_min_points" default="2"/>
  <arg name="teb_blind_zone_front_hold_min_points" default="3"/>
  <arg name="teb_blind_zone_turn_guard_linear_cap_mps" default="0.12"/>
  <arg name="teb_blind_zone_turn_recovery_stop_s" default="0.35"/>
  <arg name="teb_near_goal_side_turn_guard_stop_distance_m" default="0.22"/>
  <arg name="teb_near_goal_side_turn_guard_release_distance_m" default="0.30"/>
  <arg name="teb_near_goal_side_turn_guard_short_segment_stop_distance_m" default="0.12"/>
  <arg name="teb_near_goal_side_turn_guard_short_segment_release_distance_m" default="0.18"/>
  <arg name="teb_near_goal_side_turn_guard_rotate_away_angular_speed" default="0.12"/>
  <arg name="teb_near_goal_side_turn_guard_rotate_away_linear_cap_mps" default="0.04"/>
  <arg name="teb_behavior_cmd_timeout_s" default="0.8"/>
  <arg name="teb_rear_approach_conservative_enabled" default="true"/>
  <arg name="teb_rear_approach_max_angular_speed" default="0.12"/>
  <arg name="teb_rear_approach_spin_linear_threshold_mps" default="0.05"/>
  <arg name="teb_rear_approach_no_reverse" default="true"/>
  <arg name="teb_local_hold_timeout_s" default="1.0"/>
  <arg name="teb_publish_final_goal_only" default="true"/>
  <arg name="teb_move_base_goal_lookahead_m" default="3.0"/>
  <arg name="teb_move_base_goal_update_min_dist_m" default="0.70"/>
  <arg name="teb_local_goal_tail_backoff_m" default="0.45"/>
  <arg name="teb_local_goal_tail_backoff_trigger_m" default="1.10"/>
  <arg name="teb_emergency_stop_front_margin" default="0.40"/>
  <arg name="teb_emergency_stop_side_margin" default="0.05"/>
  <arg name="teb_emergency_stop_far_lateral_ratio" default="0.55"/>
  <arg name="teb_slowdown_front_margin" default="0.95"/>
  <arg name="teb_slowdown_side_margin" default="0.08"/>
  <arg name="teb_slowdown_far_lateral_ratio" default="0.75"/>
